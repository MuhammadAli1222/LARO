jsonl')\n","summary_file = os.path.join(CORPUS_DIR, 'chunking_summary_report.json')\n","\n","if os.path.exists(chunks_file):\n","    size_gb = os.path.getsize(chunks_file) / (1024**3)\n","    print(f\"✅ Chunked Dataset File  : {os.path.basename(chunks_file)}\")\n","    print(f\"   ➜ Path               : {chunks_file}\")\n","    print(f\"   ➜ File Size          : {size_gb:.2f} GB\")\n","else:\n","    print(f\"❌ Chunked dataset missing: {chunks_file}\")\n","\n","if os.path.exists(summary_file):\n","    with open(summary_file, 'r', encoding='utf-8') as f:\n","        summary = json.load(f)\n","    print(f\"   ➜ Total Articles     : {summary.get('total_raw_articles_processed'):,}\")\n","    print(f\"   ➜ Total Passages     : {summary.get('total_passages_generated'):,}\")\n","\n","# C. Verify BM25 Lexical Index\n","print(\"\\n--- [B] BM25 Lexical Index Substrate ---\")\n","if os.path.exists(BM25_DIR):\n","    bm25_files = os.listdir(BM25_DIR)\n","    bm25_size = calculate_folder_size_gb(BM25_DIR)\n","    print(f\"✅ BM25 Lucene Index     : Active & Validated ({len(bm25_files)} index files)\")\n","    print(f\"   ➜ Path               : {BM25_DIR}\")\n","    print(f\"   ➜ Total Size on Drive: {bm25_size:.2f} GB\")\n","else:\n","    print(f\"❌ BM25 Index missing    : {BM25_DIR}\")\n","\n","# D. Verify FAISS Dense Index Shards\n","print(\"\\n--- [C] FAISS Dense Vector Index Substrate ---\")\n","if os.path.exists(FAISS_DIR):\n","    faiss_files = os.listdir(FAISS_DIR)\n","    index_shards = sorted([f for f in faiss_files if f.endswith('.index')])\n","    mapping_files = sorted([f for f in faiss_files if f.endswith('.json')])\n","    faiss_size = calculate_folder_size_gb(FAISS_DIR)\n","\n","    print(f\"✅ FAISS Dense Shards    : Active & Validated ({len(index_shards)} index shards, {len(mapping_files)} ID maps)\")\n","    print(f\"   ➜ Path               : {FAISS_DIR}\")\n","    print(f\"   ➜ Total Size on Drive: {faiss_size:.2f} GB\")\n","    print(\"\\n   ➜ Saved Index Shards