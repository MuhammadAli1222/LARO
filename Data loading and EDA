47bmVZSS4LZb","execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Full pleged"],"metadata":{"id":"6yr7A6sJ4Nu2"},"id":"6yr7A6sJ4Nu2"},{"cell_type":"code","source":["# ==============================================================================\n","# UPDATED END-TO-END RAG PIPELINE (ALL 6 FAISS SHARDS + PYTORCH 2.6 FIX)\n","# Diagram Execution Engine: Objective 1 (LARO)\n","# ==============================================================================\n","import os\n","import glob\n","import json\n","import time\n","import torch\n","import faiss\n","import numpy as np\n","import torch.nn as nn\n","import torch.nn.functional as F\n","from tqdm import tqdm\n","from google.colab import drive\n","from sklearn.preprocessing import StandardScaler\n","from sentence_transformers import SentenceTransformer\n","from transformers import AutoTokenizer, AutoModel, AutoModelForSeq2SeqLM\n","\n","# 1. Mount Drive & Setup Java 21\n","drive.mount('/content/drive', force_remount=True)\n","\n","jvm_locations = glob.glob('/usr/lib/jvm/**/libjvm.so', recursive=True)\n","if jvm_locations:\n","    j21_path = [p for p in jvm_locations if '21' in p]\n","    chosen_jvm = j21_path[0] if j21_path else jvm_locations[0]\n","    os.environ[\"JVM_PATH\"] = chosen_jvm\n","    os.environ[\"JAVA_HOME\"] = os.path.abspath(os.path.join(os.path.dirname(chosen_jvm), \"../../..\"))\n","\n","from pyserini.search.lucene import LuceneSearcher\n","\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","print(f\"[INFO] Active Hardware Accelerator: {device.upper()}\")\n","\n","# 2. Paths Configuration\n","BASE_DIR = '/content/drive/My Drive/Objective 1'\n","BM25_DIR = os.path.join(BASE_DIR, 'indices', 'bm25')\n","FAISS_SHARDS_DIR = os.path.join(BASE_DIR, 'indices', 'faiss_shards')\n","POLICY_MODEL_PATH = os.path.join(BASE_DIR, 'laro_supervision', 'laro_4class_policy_controller.pt')\n","\n","# 3. Load BM25 Searcher\n","bm25_searcher = LuceneSearcher(BM25_DIR)\n","print(f\"✅ [LAYER 2] Lucene BM25 Index Loaded ({bm25_searcher.num_docs:,} docs)\")\n","\n","# ------------------------------------------------------------------------------\n","# MULTI-SHARD FAISS SEARCH ENGINE (LOADS & SEARCHES ALL 6 SHARDS - PROBLEM 1 FIX)\n","# ------------------------------------------------------------------------------\n","class MultiShardFAISSSearcher:\n","    def __init__(self, shards_dir):\n","        self.shards_dir = shards_dir\n","        self.shards = []\n","        self.id_maps = []\n","\n","        index_files = sorted([f for f in os.listdir(shards_dir) if f.endswith('.index')])\n","        print(f\"[INFO] Found {len(index_files)} FAISS index shards on Drive:\")\n","\n","        for idx_f in index_files:\n","            prefix = idx_f.replace('.index', '').replace('kilt_e5_shard_', '')\n","            map_f = f\"faiss_map_shard_{prefix}.json\"\n","\n","            idx_path = os.path.join(shards_dir, idx_f)\n","            map_path = os.path.join(shards_dir, map_f)\n","\n","            print(f\"   ➜ Loading {idx_f}...\")\n","            index = faiss.read_index(idx_path)\n","            with open(map_path, 'r', encoding='utf-8') as f:\n","                id_map = json.load(f)\n","\n","            self.shards.append(index)\n","            self.id_maps.append(id_map)\n","\n","        print(f\"✅ All {len(self.shards)} FAISS shards loaded successfully! Searching across ALL 21.11M passages.\")\n","\n","    def search(self, query_vector, top_k=5):\n","        all_candidates = []\n","        for index, id_map in zip(self.shards, self.id_maps):\n","            scores, indices = index.search(query_vector, top_k)\n","            for score, idx in zip(scores[0], indices[0]):\n","                if idx != -1:\n","                    cid = id_map.get(str(idx), f\"idx_{idx}\")\n","                    all_candidates.append((float(score), cid))\n","\n","        # Sort candidates by top inner-product score descending\n","        all_candidates.sort(key=lambda x: x[0], reverse=True)\n","        return all_candidates[:top_k]\n","\n","# Initialize Multi-Shard Searcher\n","multi_faiss_searcher = MultiShardFAISSSearcher(FAISS_SHARDS_DIR)\n","\n","# 4. Load Models & Encoders\n","E5_MODEL_NAME = \"intfloat/e5-large-v2\"\n","e5_tokenizer = AutoTokenizer.from_pretrained(E5_MODEL_NAME, use_fast=True)\n","e5_model = AutoModel.from_pretrained(E5_MODEL_NAME).to(device)\n","e5_model.eval()\n","\n","GENERATOR_NAME = \"google/flan-t5-base\"\n","gen_tokenizer = AutoTokenizer.from_pretrained(GENERATOR_NAME)\n","gen_model = AutoModelForSeq2SeqLM.from_pretrained(\n","    GENERATOR_NAME, output_attentions=True, output_hidden_states=True\n",").to(device)\n","gen_model.eval()\n","\n","query_encoder = SentenceTransformer(\"sentence-transformers/all-MiniLM-L6-v2\", device=device)\n","\n","# ------------------------------------------------------------------------------\n","# LOAD LARO POLICY CONTROLLER NETWORK (PYTORCH 2.6 FIX - PROBLEM 2 FIX)\n","# ------------------------------------------------------------------------------\n","class LARO4ClassPolicyMLP(nn.Module):\n","    def __init__(self, input_dim, num_classes=4):\n","        super(LARO4ClassPolicyMLP, self).__init__()\n","        self.network = nn.Sequential(\n","            nn.Linear(input_dim, 256),\n","            nn.LayerNorm(256),\n","            nn.ReLU(),\n","            nn.Dropout(0.3),\n","            nn.Linear(256, 128),\n","            nn.LayerNorm(128),\n","            nn.ReLU(),\n","            nn.Dropout(0.2),\n","            nn.Linear(128, num_classes)\n","        )\n","    def forward(self, x):\n","        return self.network(x)\n","\n","# Load Checkpoint with weights_only=False (Fixes PyTorch 2.6 UnpicklingError)\n","checkpoint = torch.load(POLICY_MODEL_PATH, map_location=device, weights_only=False)\n","input_dim = checkpoint['input_dim']\n","scaler = checkpoint['scaler']\n","label_map = checkpoint['label_map']\n","inv_label_map = {v: k for k, v in label_map.items()}\n","\n","policy_net = LARO4ClassPolicyMLP(input_dim=input_dim, num_classes=4).to(device)\n","policy_net.load_state_dict(checkpoint['model_state_dict'])\n","policy_net.eval()\n","\n","print(\"✅ LARO Policy Controller Weights Loaded Successfully!\")\n","\n","# ------------------------------------------------------------------------------\n","# END-TO-END RAG PIPELINE EXECUTION (ATTACHED DIAGRAM MATCH)\n","# ------------------------------------------------------------------------------\n","def mean_pooling(model_output, attention_mask):\n","    token_embeddings = model_output[0]\n","    input_mask_expanded = attention_mask.unsqueeze(-1).expand(token_embeddings.size()).float()\n","    return torch.sum(token_embeddings * input_mask_expanded, 1) / torch.clamp(input_mask_expanded.sum(1), min=1e-9)\n","\n","def encode_dense_query(q_text):\n","    formatted = f\"query: {q_text}\"\n","    enc = e5_tokenizer([formatted], padding=True, truncation=True, max_length=256, return_tensors='pt').to(device)\n","    with torch.no_grad(), torch.amp.autocast('cuda'):\n","        out = e5_model(**enc)\n","        emb = mean_pooling(out, enc['attention_mask'])\n","        emb = F.normalize(emb, p=2, dim=1)\n","    return emb.cpu().numpy().astype('float32')\n","\n","def extract_epistemic_signals(query_text):\n","    input_ids = gen_tokenizer.encode(query_text, return_tensors=\"pt\").to(device)\n","    with torch.no_grad():\n","        outputs = gen_model(input_ids=input_ids, decoder_input_ids=input_ids)\n","        logits = outputs.logits\n","        attentions = outputs.encoder_attentions\n","\n","    log_probs = F.log_softmax(logits, dim=-1)\n","    target_log_probs = log_probs[0, range(input_ids.shape[1]-1), input_ids[0, 1:]]\n","    neg_log_likelihood = -target_log_probs.mean()\n","    perplexity = torch.exp(neg_log_likelihood).item()\n","\n","    probs = F.softmax(logits, dim=-1)\n","    top2_probs, _ = torch.topk(probs, k=2, dim=-1)\n","    margin = (top2_probs[0, :, 0] - top2_probs[0, :, 1]).mean().item()\n","    log_prob_dispersion = torch.std(target_log_probs).item()\n","\n","    layer_entropies = []\n","    for layer_attn in attentions:\n","        p = layer_attn + 1e-9\n","        entropy = -torch.sum(p * torch.log(p), dim=-1).mean().item()\n","        layer_entropies.append(entropy)\n","\n","    return {\n","        \"sigma_ppl\": round(perplexity, 4),\n","        \"sigma_attn_entropy\": round(float(np.mean(layer_entropies)), 4),\n","        \"log_prob_dispersion\": round(log_prob_dispersion, 4),\n","        \"top_margin\": round(margin, 4)\n","    }\n","\n","def rewrite_query(query_text):\n","    prompt = f\"Rewrite query to be specific: {query_text}\"\n","    inp = gen_tokenizer.encode(prompt, return_tensors=\"pt\").to(device)\n","    with torch.no_grad():\n","        out = gen_model.generate(inp, max_new_tokens=25)\n","    return gen_tokenizer.decode(out[0], skip_special_tokens=True)\n","\n","def execute_reflexive_rag_flowchart(query_text, unc_threshold_ppl=120.0):\n","    print(\"\\n\" + \"=\"*75)\n","    print(f\" USER QUERY: \\\"{query_text}\\\"\")\n","    print(\"=\"*75)\n","\n","    # --------------------------------------------------------------------------\n","    # LAYER 1: EPISTEMIC SENSING\n","    # --------------------------------------------------------------------------\n","    print(\"\\n[LAYER 1: EPISTEMIC SENSING]\")\n","    signals = extract_epistemic_signals(query_text)\n","    print(f\" ➜ Epistemic Sensor Outputs: σ_ppl = {signals['sigma_ppl']} | σ_attn = {signals['sigma_attn_entropy']}\")\n","\n","    # Decision Gate\n","    if signals['sigma_ppl'] < unc_threshold_ppl and signals['sigma_attn_entropy'] < 1.05:\n","        print(\" ➜ [DECISION GATE]: Low Uncertainty Detected! (Model knows the answer)\")\n","        print(\" ➜ [ACTION]: Skip Retrieval ──► Direct Generation (LLM)\")\n","\n","        inp = gen_tokenizer.encode(query_text, return_tensors=\"pt\").to(device)\n","        with torch.no_grad():\n","            out = gen_model.generate(inp, max_new_tokens=40)\n","            final_ans = gen_tokenizer.decode(out[0], skip_special_tokens=True)\n","\n","        print(f\"\\n✨ FINAL ANSWER (Parametric Memory): {final_ans}\")\n","        return\n","\n","    print(\" ➜ [DECISION GATE]: High Uncertainty Detected! Proceeding to Control Layer (LARO)...\")\n","\n","    # --------------------------------------------------------------------------\n","    # LAYER 2: ADAPTIVE ORCHESTRATION (LARO CONTROL LAYER)\n","    # --------------------------------------------------------------------------\n","    print(\"\\n[LAYER 2: ADAPTIVE ORCHESTRATION - LARO]\")\n","\n","    # Feature Vector Construction\n","    q_emb = query_encoder.encode([query_text], convert_to_numpy=True)\n","    cues_arr = np.array([[signals['sigma_ppl'], signals['sigma_attn_entropy'], signals['log_prob_dispersion'], signals['top_margin']]])\n","    cues_scaled = scaler.transform(cues_arr)\n","\n","    x_input = torch.tensor(np.hstack([q_emb, cues_scaled]), dtype=torch.float32).to(device)\n","\n","    # Policy Prediction\n","    with torch.no_grad():\n","        logits = policy_net(x_input)\n","        probs = F.softmax(logits, dim=1).cpu().numpy()[0]\n","        pred_action_id = int(torch.argmax(logits, dim=1).item())\n","\n","    action_name = inv_label_map[pred_action_id]\n","    print(f\" ➜ LARO Policy Controller Prediction: [{action_name}] (Confidence: {probs[pred_action_id]*100:.1f}%)\")\n","\n","    # Action Space Execution Across All 21.11M Passages\n","    retrieved_documents = []\n","\n","    if action_name == \"SKIP\":\n","        prompt = query_text\n","    elif action_name == \"LEXICAL_BM25\":\n","        hits = bm25_searcher.search(query_text, k=3)\n","        for h in hits:\n","            d = bm25_searcher.doc(h.docid)\n","            if d and d.raw():\n","                try: retrieved_documents.append(json.loads(d.raw()).get(\"contents\", \"\"))\n","                except: retrieved_documents.append(d.contents())\n","        prompt = f\"Context: {' '.join(retrieved_documents)[:800]} Query: {query_text}\"\n","\n","    elif action_name == \"SEMANTIC_DENSE\":\n","        q_vec = encode_dense_query(query_text)\n","        top_matches = multi_faiss_searcher.search(q_vec, top_k=3)\n","        for score, cid in top_matches:\n","            retrieved_documents.append(f\"[Chunk ID: {cid} | Score: {score:.4f}]\")\n","        prompt = f\"Context: {' '.join(retrieved_documents)[:800]} Query: {query_text}\"\n","\n","    elif action_name == \"REWRITE_RETRIEVE\":\n","        rw_q = rewrite_query(query_text)\n","        print(f\" ➜ Rewritten Sub-Query: \\\"{rw_q}\\\"\")\n","        q_vec_rw = encode_dense_query(rw_q)\n","        top_matches = multi_faiss_searcher.search(q_vec_rw, top_k=3)\n","        for score, cid in top_matches:\n","            retrieved_documents.append(f\"[Chunk ID: {cid} | Score: {score:.4f}]\")\n","        prompt = f\"Context: {' '.join(retrieved_documents)[:800]} Query: {query_text}\"\n","\n","    # Final Grounded Synthesis\n","    inp = gen_tokenizer.encode(prompt, return_tensors=\"pt\", truncation=True, max_length=512).to(device)\n","    with torch.no_grad():\n","        out = gen_model.generate(inp, max_new_tokens=50)\n","        final_ans = gen_tokenizer.decode(out[0], skip_special_tokens=True)\n","\n","    print(f\"\\n📚 Raw Retrieved Docs (D_raw): {len(retrieved_documents)} passages fetched across 21.11M database\")\n","    print(f\"✨ FINAL VERIFIED ANSWER: {final_ans}\")\n","\n","# ------------------------------------------------------------------------------\n","# TEST THE PIPELINE ON SAMPLE QUERIES\n","# ------------------------------------------------------------------------------\n","execute_reflexive_rag_flowchart(\"When was Universiti Teknologi Malaysia founded?\")\n","execute_reflexive_rag_flowchart(\"Who directed the movie Inception in 2010?\")\n","execute_reflexive_rag_flowchart(\"Analyze the causal relationship between national GDP growth and trade tar