t json\n","import torch\n","import faiss\n","import torch.nn.functional as F\n","from tqdm import tqdm\n","from transformers import AutoTokenizer, AutoModel\n","from google.colab import drive\n","\n","# 1. Mount Google Drive\n","drive.mount('/content/drive', force_remount=True)\n","\n","# 2. Hardware Accelerator Setup\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","print(f\"[INFO] Active Hardware Accelerator: {device.upper()}\")\n","\n","# 3. Paths Configuration\n","BASE_DIR = '/content/drive/My Drive/Objective 1'\n","FULL_CHUNKS_PATH = os.path.join(BASE_DIR, 'full_chunked_corpus', 'kilt_wikipedia_chunks_full.jsonl')\n","\n","FAISS_SHARDS_DIR = os.path.join(BASE_DIR, 'indices', 'faiss_shards')\n","os.makedirs(FAISS_SHARDS_DIR, exist_ok=True)\n","\n","# 4. Load E5 Model & Fast Tokenizer\n","MODEL_NAME = \"intfloat/e5-large-v2\"\n","print(f\"[INFO] Loading Dense Model & Tokenizer ({MODEL_NAME})...\")\n","\n","tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, use_fast=True)\n","model = AutoModel.from_pretrained(MODEL_NAME).to(device)\n","model.eval()\n","\n","EMBEDDING_DIM = 1024  # Output dimension of e5-large-v2\n","\n","# 5. Mean Pooling Function for E5 Embeddings\n","def mean_pooling(model_output, attention_mask):\n","    token_embeddings = model_output[0]\n","    input_mask_expanded = attention_mask.unsqueeze(-1).expand(token_embeddings.size()).float()\n","    return torch.sum(token_embeddings * input_mask_expanded, 1) / torch.clamp(input_mask_expanded.sum(1), min=1e-9)\n","\n","# 6. Sharding & Checkpoint Parameters\n","SHARD_SIZE = 2000000  # Save a checkpoint every 2,000,000 vectors\n","BATCH_SIZE = 256\n","\n","current_shard_idx = 1\n","current_shard_count = 0\n","total_passages_indexed = 0\n","\n","# Initialize CPU FAISS Index for current shard\n","faiss_index = faiss.IndexFlatIP(EMBEDDING_DIM)  # CPU Index (No GPU VRAM OOM!)\n","chunk_id_map = {}\n","\n","text_batch = []\n","chunk_id_batch = []\n","\n","def save_shard_checkpoint(shard_num, index_obj, mapping_dict):\n","    \"\"\"Saves a 2M vector shard and ID mapping directly to Drive.\"\"\"\n","    shard_index_path = os.path.join(FAISS_SHARDS_DIR, f'kilt_e5_shard_{shard_num:02d}.index')\n","    shard_map_path = os.path.join(FAISS_SHARDS_DIR, f'faiss_map_shard_{shard_num:02d}.json')\n","\n","    print(f\"\\n[CHECKPOINT] Saving Shard {shard_num:02d} ({index_obj.ntotal:,} vectors) to Drive...\")\n","    faiss.write_index(index_obj, shard_index_path)\n","    with open(shard_map_path, 'w', encoding='utf-8') as f:\n","        json.dump(mapping_dict, f)\n","    print(f\"✅ Shard {shard_num:02d} saved at: {shard_index_path}\")\n","\n","print(\"\\n======================================================================\")\n","print(\" STARTING FAIL-SAFE SHARDED FAISS INDEXING\")\n","print(\"======================================================================\")\n","\n","with open(FULL_CHUNKS_PATH, 'r', encoding='utf-8') as in_f:\n","    for line in tqdm(in_f, total=21113601, desc=\"Embedding Passages\"):\n","        total_passages_indexed += 1\n","\n","        # Determine which shard this passage belongs to\n","        target_shard = ((total_passages_indexed - 1) // SHARD_SIZE) + 1\n","\n","        # Auto-Resume Check: Skip passages if shard already exists on Drive\n","        existing_shard_path = os.path.join(FAISS_SHARDS_DIR, f'kilt_e5_shard_{target_shard:02d}.index')\n","        if os.path.exists(existing_shard_path):\n","            if target_shard > current_shard_idx:\n","                current_shard_idx = target_shard\n","                print(f\"\\n[AUTO-RESUME] Found existing Shard {target_shard-1:02d} on Drive. Skipping to Shard {target_shard:02d}...\")\n","            continue\n","\n","        chunk = json.loads(line)\n","        chunk_id = chunk.get(\"chunk_id\")\n","        text = chunk.get(\"text\", \"\")\n","\n","        text_batch.append(f\"passage: {text}\")\n","        chunk_id_batch.append(chunk_id)\n","\n","        if len(text_batch) 