argin=0.0801\n","Rewards       : SKIP=-0.005 | SPARSE=-0.3519\n","Optimal Action: [SKIP] 🎯\n","-----------------------------------------------------------------\n","\n","--- [TASK: TRIVIAQA] ---\n","Query         : Who was the man behind The Chipmunks?\n","Signals       : σ_ppl=49.7521 | σ_attn=1.0689 | Margin=0.3034\n","Rewards       : SKIP=-0.0077 | SPARSE=-0.0122\n","Optimal Action: [SKIP] 🎯\n","-----------------------------------------------------------------\n"]},{"output_type":"stream","name":"stderr","text":["\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"ixtiQ-32OhDd"},"id":"ixtiQ-32OhDd","execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"wPkCRPJcPufE"},"id":"wPkCRPJcPufE","execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Step 3: LARO Policy Network Training Script"],"metadata":{"id":"9av6TVe6Pvol"},"id":"9av6TVe6Pvol"},{"cell_type":"code","source":["# ==============================================================================\n","# UPDATED STEP 2: 4-ACTION TRAJECTORY SIMULATION (EXACT FIGURE 3.1 MATCH)\n","# Actions: [0: SKIP, 1: LEXICAL_BM25, 2: SEMANTIC_DENSE, 3: REWRITE_RETRIEVE]\n","# ==============================================================================\n","!pip install -q faiss-gpu pyserini datasets sentence-transformers\n","\n","import os\n","import glob\n","import json\n","import time\n","import torch\n","import faiss\n","import pandas as pd\n","import numpy as np\n","import torch.nn.functional as F\n","from tqdm import tqdm\n","from datasets import load_dataset\n","\n","# 1. Setup Java 21 & Paths\n","jvm_locations = glob.glob('/usr/lib/jvm/**/libjvm.so', recursive=True)\n","if jvm_locations:\n","    j21_path = [p for p in jvm_locations if '21' in p]\n","    chosen_jvm = j21_path[0] if j21_path else jvm_locations[0]\n","    os.environ[\"JVM_PATH\"] = chosen_jvm\n","    os.environ[\"JAVA_HOME\"] = os.path.abspath(os.path.join(os.path.dirname(chosen_jvm), \"../../..\"))\n","\n","from pyserini.search.lucene import LuceneSearcher\n","from transformers import AutoTokenizer, AutoModel, AutoModelForSeq2SeqLM\n","\n","BASE_DIR = '/content/drive/My Drive/Objective 1'\n","SUPERVISION_DIR = os.path.join(BASE_DIR, 'laro_supervision')\n","os.makedirs(SUPERVISION_DIR, exist_ok=True)\n","\n","ORACLE_4CLASS_PATH = os.path.join(SUPERVISION_DIR, 'laro_oracle_supervision_4class_2000.jsonl')\n","BM25_DIR = os.path.join(BASE_DIR, 'indices', 'bm25')\n","FAISS_SHARDS_DIR = os.path.join(BASE_DIR, 'indices', 'faiss_shards')\n","\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","print(f\"[INFO] Active Hardware Accelerator: {device.upper()}\")\n","\n","# Load BM25 Searcher\n","bm25_searcher = LuceneSearcher(BM25_DIR)\n","print(f\"✅ Lucene BM25 Searcher loaded! Total docs: {bm25_searcher.num_docs:,}\")\n","\n","# 2. Load FAISS Dense Index Shard & Mapping\n","FAISS_SHARD_PATH = os.path.join(FAISS_SHARDS_DIR, 'kilt_e5_shard_02.index')\n","FAISS_MAP_PATH = os.path.join(FAISS_SHARDS_DIR, 'faiss_map_shard_02.json')\n","\n","faiss_index = faiss.read_index(FAISS_SHARD_PATH)\n","with open(FAISS_MAP_PATH, 'r') as f:\n","    faiss_id_map = json.load(f)\n","\n","print(f\"✅ FAISS Dense Shard loaded! Total vectors: {faiss_index.ntotal:,}\")\n","\n","# 3. Load E5 Dense Encoder & Backbone Generator\n","E5_MODEL_NAME = \"intfloat/e5-large-v2\"\n","print(f\"[INFO] Loading E5 Dense Model ({E5_MODEL_NAME})...\")\n","e5_tokenizer = AutoTokenizer.from_pretrained(E5_MODEL_NAME, use_fast=True)\n","e5_model = AutoModel.from_pretrained(E5_MODEL_NAME).to(device)\n","e5_model.eval()\n","\n","GENERATOR_NAME = \"google/flan-t5-base\"\n","print(f\"[INFO] Loading Generator Model ({GENERATOR_NAME})...\")\n","gen_tokenizer = AutoTokenizer.from_pretrained(GENERATOR_NAME)\n","gen_model = AutoModelForSeq2SeqLM.from_pretrained(\n","    GENERATOR_NAME, output_attentions=True, output_hidden_states=True\n",").to(device)\n","gen_model.eval()\n","\n","# Helpers\n","def mean_pooling(model_output, attention_mask):\n","    token_embeddings = model_output[0]\n","    input_mask_expanded = attention_mask.unsqueeze(-1).expand(token_embeddings.size()).float()\n","    return torch.sum(token_embeddings * input_mask_expanded, 1) / torch.clamp(input_mask_expanded.sum(1), min=1e-9)\n","\n","def encode_dense_query(q_text):\n","    formatted = f\"query: {q_text}\"\n","    enc = e5_tokenizer([formatted], padding=True, truncation=True, max_length=256, return_tensors='pt').to(device)\n","    with torch.no_grad(), torch.amp.autocast('cuda'):\n","        out = e5_model(**enc)\n","        emb = mean_pooling(out, enc['attention_mask'])\n","        emb = F.normalize(emb, p=2, dim=1)\n","    return emb.cpu().numpy().astype('float32')\n","\n","def extract_epistemic_signals(query_text):\n","    input_ids = gen_tokenizer.encode(query_text, return_tensors=\"pt\").to(device)\n","    with torch.no_grad():\n","        outputs = gen_model(input_ids=input_ids, decoder_input_ids=input_ids)\n","        logits = outputs.logits\n","        attentions = outputs.encoder_attentions\n","\n","    log_probs = F.log_softmax(logits, dim=-1)\n","    target_log_probs = log_probs[0, range(input_ids.shape[1]-1), input_ids[0, 1:]]\n","    neg_log_likelihood = -target_log_probs.mean()\n","    perplexity = torch.exp(neg_log_likelihood).item()\n","\n","    probs = F.softmax(logits, dim=-1)\n","    top2_probs, _ = torch.topk(probs, k=2, dim=-1)\n","    margin = (top2_probs[0, :, 0] - top2_probs[0, :, 1]).mean().item()\n","    log_prob_dispersion = torch.std(target_log_probs).item()\n","\n","    layer_entropies = []\n","    for layer_attn in attentions:\n","        p = layer_attn + 1e-9\n","        entropy = -torch.sum(p * torch.log(p), dim=-1).mean().item()\n","        layer_entropies.append(entropy)\n","\n","    return {\n","        \"query\": query_text,\n","        \"sigma_ppl\": round(perplexity, 4),\n","        \"sigma_attn_entropy\": round(float(np.mean(layer_entropies)), 4),\n","        \"log_prob_dispersion\": round(log_prob_dispersion, 4),\n","        \"top_margin\": round(margin, 4)\n","    }\n","\n","def check_exact_match(pred, gts):\n","    pred_clean = pred.lower().strip()\n","    for gt in gts:\n","        if gt and (gt.lower().strip() in pred_clean or pred_clean in gt.lower().strip()):\n","            return 1.0\n","    return 0.0\n","\n","def rewrite_query(query_text):\n","    \"\"\"Action Option 4: Query Rewriting\"\"\"\n","    prompt = f\"Rewrite query to be clear: {query_text}\"\n","    inp = gen_tokenizer.encode(prompt, return_tensors=\"pt\").to(device)\n","    with torch.no_grad():\n","        out = gen_model.generate(inp, max_new_tokens=25)\n","    return gen_tokenizer.decode(out[0], skip_special_tokens=True)\n","\n","# 4. Collect 2,000 Stratified Queries\n","print(\"\\n======================================================================\")\n","print(\" 1. COLLECTING 2,000 QUERIES FOR 4-ACTION TRAJECTORY SIMULATION\")\n","print(\"======================================================================\")\n","\n","queries_pool = []\n","\n","for task_name, count in [(\"nq\", 800), (\"hotpotqa\", 700)]:\n","    ds = load_dataset(\"facebook/kilt_tasks\", task_name, split=\"validation\")\n","    extracted = 0\n","    for item in ds:\n","        q_text = item.get(\"input\", \"\")\n","        answers = [alt.get(\"answer\", \"\") for alt in item.get(\"output\", []) if alt.get(\"answer\")]\n","        if q_text and answers:\n","            queries_pool.append({\"task\": task_name, \"query\": q_text, \"answers\": answers})\n","            extracted += 1\n","            if extracted >= count: break\n","\n","ds_trivia = load_dataset(\"mandarjoshi/trivia_qa\", \"rc.nocontext\", split=\"validation\")\n","extracted = 0\n","for item in ds_trivia:\n","    q_text = item.get(\"question\", \"\")\n","    ans_dict = item.get(\"answer\", {})\n","    answers = [ans_dict.get(\"value\", \"\")] + ans_dict.get(\"aliases\", [])\n","    answers = list(set([a for a in answers if str(a).strip()]))\n","    if q_text and answers:\n","        queries_pool.append({\"task\": \"triviaqa\", \"query\": q_text, \"answers\": answers})\n","        extracted += 1\n","        if extracted >= 500: break\n","\n","print(f\"✅ Total Supervision Pool: {len(queries_pool):,} queries\")\n","\n","# 5. Simulate All 4 Actions\n","print(\"\\n======================================================================\")\n","print(\" 2. SIMULATING ALL 4 ACTION TRAJECTORIES PER QUERY\")\n","print(\"======================================================================\")\n","\n","LAMBDA_LATENCY = 0.05\n","oracle_4class_records = []\n","\n","for item in tqdm(queries_pool, desc=\"Simulating 4 Actions\"):\n","    q_text = item[\"query\"]\n","    gts = item[\"answers\"]\n","\n","    signals = extract_epistemic_signals(q_text)\n","\n","    # -------------------------------------------------------------\n","    # ACTION 0: SKIP (Parametric Memory Generation)\n","    # -------------------------------------------------------------\n","    t0 = time.time()\n","    inp_ids = gen_tokenizer.encode(q_text, return_tensors=\"pt\").to(device)\n","    with torch.no_grad():\n","        out_skip = gen_model.generate(inp_ids, max_new_tokens=30)\n","        ans_skip = gen_tokenizer.decode(out_skip[0], skip_special_tokens=True)\n","    lat_skip = time.time() - t0\n","    r_skip = check_exact_match(ans_skip, gts) - (LAMBDA_LATENCY * lat_skip)\n","\n","    # -------------------------------------------------------------\n","    # ACTION 1: LEXICAL (BM25 Top-5)\n","    # -------------------------------------------------------------\n","    t0 = time.time()\n","    hits = bm25_searcher.search(q_text, k=5)\n","    texts_bm25 = []\n","    for h in hits:\n","        d = bm25_searcher.doc(h.docid)\n","        if d and d.raw():\n","            try: texts_bm25.append(json.loads(d.raw()).get(\"contents\", \"\"))\n","            except: texts_bm25.append(d.contents())\n","    prompt_bm25 = f\"Context: {' '.join(texts_bm25)[:1000]} Query: {q_text}\"\n","    inp_ids = gen_tokenizer.encode(prompt_bm25, return_tensors=\"pt\", truncation=True, max_length=512).to(device)\n","    with torch.no_grad():\n","        out_bm25 = gen_model.generate(inp_ids, max_new_tokens=30)\n","        ans_bm25 = gen_tokenizer.decode(out_bm25[0], skip_special_tokens=True)\n","    lat_bm25 = time.time() - t0\n","    r_lexical = check_exact_match(ans_bm25, gts) - (LAMBDA_LATENCY * lat_bm25)\n","\n","    # -------------------------------------------------------------\n","    # ACTION 2: SEMANTIC DENSE (FAISS Top-5)\n","    # -------------------------------------------------------------\n","    t0 = time.time()\n","    q_vec = encode_dense_query(q_text)\n","    scores, indices = faiss_index.search(q_vec, 5)\n","    texts_dense = [faiss_id_map.get(str(idx), \"\") for idx in indices[0]]\n","    prompt_dense = f\"Context: {' '.join(texts_dense)[:1000]} Query: {q_text}\"\n","    inp_ids = gen_tokenizer.encode(prompt_dense, return_tensors=\"pt\", truncation=True, max_length=512).to(device)\n","    with torch.no_grad():\n","        out_dense = gen_model.generate(inp_ids, max_new_tokens=30)\n","        ans_dense = gen_tokenizer.decode(out_dense[0], skip_special_tokens=True)\n","    lat_dense = time.time() - t0\n","    r_dense = check_exact_match(ans_dense, gts) - (LAMBDA_LATENCY * lat_dense)\n","\n","    # -------------------------------------------------------------\n","    # ACTION 3: REWRITE-RETRIEVE (Query Rewrite + FAISS)\n","    # -------------------------------------------------------------\n","    t0 = time.time()\n","    rewritten_q = rewrite_query(q_text)\n","    q_vec_rw = encode_dense_query(rewritten_q)\n","    scores_rw, indices_rw = faiss_index.search(q_vec_rw, 5)\n","    texts_rw = [faiss_id_map.get(str(idx), \"\") for idx in indices_rw[0]]\n","    prompt_rw = f\"Context: {' '.join(texts_rw)[:1000]} Query: {rewritten_q}\"\n","    inp_ids = gen_tokenizer.encode(prompt_rw, return_tensors=\"pt\", truncation=True, max_length=512).to(device)\n","    with torch.no_grad():\n","        out_rw = gen_model.generate(inp_ids, max_new_tokens=30)\n","        ans_rw = gen_tokenizer.decode(out_rw[0], skip_special_tokens=True)\n","    lat_rw = time.time() - t0\n","    r_rewrite = check_exact_match(ans_rw, gts) - (LAMBDA_LATENCY * lat_rw)\n","\n","    # -------------------------------------------------------------\n","    # OPTIMAL ACTION SELECTION (a*)\n","    # -------------------------------------------------------------\n","    rewards_dict = {\n","        \"SKIP\": r_skip,\n","        \"LEXICAL_BM25\": r_lexical,\n","        \"SEMANTIC_DENSE\": r_dense,\n","        \"REWRITE_RETRIEVE\": r_rewrite\n","    }\n","    optimal_a = max(rewards_dict, key=rewards_dict.get)\n","\n","    oracle_4class_records.append({\n","        \"query\": q_text,\n","        \"task\": item[\"task\"],\n","        \"sigma_ppl\": signals[\"sigma_ppl\"],\n","        \"sigma_attn_entropy\": signals[\"sigma_attn_entropy\"],\n","        \"log_prob_dispersion\": signals[\"log_prob_dispersion\"],\n","        \"top_margin\": signals[\"top_margin\"],\n","        \"oracle_action\": optimal_a,\n","        \"reward_skip\": round(r_skip, 4),\n","        \"reward_lexical\": round(r_lexical, 4),\n","        \"reward_dense\": round(r_dense, 4),\n","        \"reward_rewrite\": round(r_rewrite, 4)\n","    })\n","\n","# Save 4-Class Supervision Dataset\n","with open(ORACLE_4CLASS_PATH, 'w', encoding='utf-8') as f:\n","    for rec in oracle_4class_records:\n","        f.write(json.dumps(rec) + '\\n')\n","\n","# Display Summary\n","df_4c = pd.DataFrame(oracle_4class_records)\n","print(\"\\n======================================================================\")\n","print(\" 4-CLASS ORACLE SUPERVISION DATASET SUMMARY\")\n","print(\"======================================================================\")\n","print(f\"✅ Total Annotated Samples: {len(df_4c):,}\")\n","print(\"\\n--- Action Distribution 