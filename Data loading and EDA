 ---\")\n","action_counts = df_supervision['oracle_action'].value_counts()\n","action_pct = df_supervision['oracle_action'].value_counts(normalize=True) * 100\n","df_action_summary = pd.DataFrame({'Count': action_counts, 'Percentage (%)': action_pct.round(2)})\n","print(df_action_summary.to_string())\n","\n","print(\"\\n--- [B] Action Distribution Breakdown by Task Split ---\")\n","task_action = pd.crosstab(df_supervision['task'], df_supervision['oracle_action'], margins=True)\n","print(task_action.to_string())\n","\n","print(\"\\n--- [C] Average Epistemic Uncertainty Signals by Oracle Action ---\")\n","signals_summary = df_supervision.groupby('oracle_action').agg(\n","    Mean_PPL=('sigma_ppl', 'mean'),\n","    Mean_Attention_Entropy=('sigma_attn_entropy', 'mean'),\n","    Mean_LogProb_Dispersion=('log_prob_dispersion', 'mean'),\n","    Mean_Top_Margin=('top_margin', 'mean')\n",").round(4)\n","print(signals_summary.to_string())\n","\n","print(\"\\n======================================================================\")\n","print(\" 3. SAMPLE ANNOTATED ORACLE RECORDS\")\n","print(\"======================================================================\")\n","\n","for i, r in df_supervision.head(5).iterrows():\n","    print(f\"\\n--- [SAMPLE {i+1}] Task: {str(r['task']).upper()} ---\")\n","    print(f\"Query         : {r['query']}\")\n","    print(f\"Signals       : σ_ppl={r['sigma_ppl']} | σ_attn={r['sigma_attn_entropy']} | Margin={r['top_margin']}\")\n","    print(f\"Rewards       : SKIP={r['reward_skip']} | SPARSE={r['reward_sparse']}\")\n","    print(f\"Optimal Action: [{r['oracle_action']}] 🎯\")\n","    print(\"-\" * 65)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"34W_CN0OITft","executionInfo":{"status":"ok","timestamp":1785216753406,"user_tz":-480,"elapsed":79,"user":{"displayName":"MUHAMMAD ALI","userId":"01574840028316529342"}},"outputId":"ee538dd7-d293-4aee-f981-cac057f9174a"},"id":"34W_CN0OITft","execution_count":null,"outputs":[{"ou