use_fast=True)\n","\n","# 3. Clean Text Function (Resolves Section::::, BULLET::::, and Unicode Noise)\n","def clean_wikipedia_text(raw_text):\n","    if not raw_text:\n","        return \"\"\n","    if isinstance(raw_text, list):\n","        raw_text = \" \".join(raw_text)\n","\n","    # A. Unicode Normalization (NFKC)\n","    text = unicodedata.normalize('NFKC', raw_text)\n","\n","    # B. Clean KILT structural markers\n","    text = re.sub(r'Section::::\\s*', '\\n\\n', text)\n","    text = re.sub(r'BULLET::::\\s*', '\\n• ', text)\n","\n","    # C. Normalize excessive whitespace & redundant empty lines\n","    text = re.sub(r'[ \\t]+', ' ', text)\n","    text = re.sub(r'\\n{3,}', '\\n\\n', text)\n","\n","    return text.strip()\n","\n","# 4. Chunking Configuration\n","CHUNK_SIZE = 256\n","OVERLAP = 50\n","STEP_SIZE = CHUNK_SIZE - OVERLAP  # 206 tokens\n","\n","BUFFER_SIZE = 50000  # Flush buffer to Drive every 50,000 chunks\n","chunk_buffer = []\n","\n","total_articles = 0\n","total_passages = 0\n","empty_articles_skipped = 0\n","\n","start_time = time.time()\n","\n","print(\"\\n======================================================================\")\n","print(\" STARTING FULL DATASET PROCESSING & CHUNKING PIPELINE\")\n","print(\"======================================================================\")\n","print(f\"➜ Input File   : {INPUT_WIKI_PATH}\")\n","print(f\"➜ Output File  : {OUTPUT_FULL_CHUNKS}\")\n","print(f\"➜ Chunk Config : {CHUNK_SIZE} tokens | {OVERLAP} token overlap (Step: {STEP_SIZE})\")\n","\n","# 5. Full Dataset Streaming & Processing Loop\n","with open(INPUT_WIKI_PATH, 'r', encoding='utf-8') as in_f, \\\n","     open(OUTPUT_FULL_CHUNKS, 'w', encoding='utf-8') as out_f:\n","\n","    # Use tqdm stream wrapper\n","    for line in tqdm(in_f, desc=\"Processing Articles\", unit=\" art\"):\n","        doc = json.loads(line)\n","        doc_id = doc.get(\"id\", \"\")\n","        doc_title = doc.get(\"title\", \"\")\n","        raw_text = doc.get(\"text\", \"\")\n","\n","        # Apply Clean Preprocessing\n","        cleaned_text = clean_wikipedia_text(raw_text)\n","        if not cleaned_text:\n","            empty_articles_skipped += 1\n","            continue\n","\n","        total_articles += 1\n","\n","        # Tokenize cleaned document\n","        input_ids = tokenizer.encode(cleaned_text, add_special_tokens=False)\n","\n","        # Sliding-Window Chunking\n","        chunk_idx = 0\n","        for start_idx in range(0, len(input_ids), STEP_SIZE):\n","            end_idx = start_idx + CHUNK_SIZE\n","            chunk_ids = input_ids[start_idx:end_idx]\n","\n","            # Decode chunk back to text\n","            chunk_text = tokenizer.decode(chunk_ids, skip_special_tokens=True)\n","\n","            chunk_record = {\n","                \"chunk_id\": f\"{doc_id}_{chunk_idx}\",\n","                \"source_article_id\": doc_id,\n","                \"source_article_title\": doc_title,\n","                \"text\": chunk_text\n","            }\n","\n","            chunk_buffer.append(json.dumps(chunk_record) + '\\n')\n","            total_passages += 1\n","            chunk_idx += 1\n","\n","            # Flush write buffer when full\n","            if len(chunk_buffer) >= BUFFER_SIZE:\n","                out_f.writelines(chunk_buffer)\n","                chunk_buffer.clear()\n","\n","    # Flush any remaining chunks in final buffer\n","    if chunk_buffer:\n","        out_f.writelines(chunk_buffer)\n","        chunk_buffer.clear()\n","\n","elapsed_hours = (time.time() - start_time) / 3600.0\n","\n","# 6. Generate Summary Report\n","summary_report = {\n","    \"pipeline_status\": \"SUCCESS\",\n","    \"total_raw_articles_processed\": total_articles,\n","    \"empty_articles_skipped\": empty_articles_skipped,\n","    \"total_passages_generated\": total_passages,\n","    \"average_passages_per_article\": round(total_passages / total_articles, 2) if total_articles > 0 else 0,\n","    \"chunk_size_tokens\": CHUNK_SIZE,\n","    \"overlap_tokens\": OVERLAP,\n","    \"execution_time_hours\": round(elapsed_hours, 2),\n","    \"output_file_path\": OUTPUT_FULL_CHUNKS\n","}\n","\n","with open(OUTPUT_SUMMARY_JSON, 'w', encoding='utf-8') as sum_f:\n","    json.dump(summary_report, indent=2, fp=sum_f)\n","\n","print(\"\\n======================================================================\")\n","print(\" PIPELINE EXECUTION SUMMARY & FINAL DATASET COUNT\")\n","print(\"======================================================================\")\n","print(f\"✅ Total Wikipedia Articles Processed : {total_articles:,}\")\n","print(f\"✅ Total Passages/Chunks Generated     : {total_passages:,}\")\n","print(f\"✅ Average Passages per Article        : {summary_report['average_passages_per_article']}\")\n","print(f\"✅ Total Execution Time                : {elapsed_hours:.2f} hours\")\n","print(f\"✅ Full Chunked Dataset Saved At        : {OUTPUT_FULL_CHUNKS}\")\n","print(f\"✅ Summary Report Saved At             : {OUTPUT_SUMMARY_JSON}\")"]},{"cell_type":"code","execution_count":null,"id":"e70a5ee2","metadata":{"id":"e70a5ee2"},"outputs":[],"source":[]},{"cell_type":"code","source":["# ==============================================================================\n","# LOCATION & FILE INTEGRITY VERIFICATION SCRIPT\n","# Objective 1: Non-Parametric Knowledge Substrate\n","# ==============================================================================\n","import os\n","import json\n","\n","# 1. Define paths\n","TARGET_DIR = '/content/drive/My Drive/Objective 1/full_chunked_corpus'\n","CHUNKS_FILE = os.path.join(TARGET_DIR, 'kilt_wikipedia_chunks_full.jsonl')\n","SUMMARY_FILE = os.path.join(TARGET_DIR, 'chunking_summary_report.json')\n","\n","print(\"======================================================================\")\n","print(\" 1. LOCATION & FILE SIZE VERIFICATION\")\n","print(\"======================================================================\")\n","\n","if os.path.exists(TARGET_DIR):\n