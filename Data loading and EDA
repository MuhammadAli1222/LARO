============================================================================\n","# STEP 1: EPISTEMIC SENSING ENGINE (SECTION 3.2.1.1)\n","# Objective 1: Real-Time Internal Uncertainty Extraction\n","# ==============================================================================\n","import os\n","import json\n","import torch\n","import numpy as np\n","import torch.nn.functional as F\n","from transformers import AutoTokenizer, AutoModelForCausalLM, AutoModelForSeq2SeqLM\n","from google.colab import drive\n","\n","# 1. Setup Device\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","print(f\"[INFO] Active Hardware Accelerator: {device.upper()}\")\n","\n","# 2. Load Frozen Generator Backbone (Using T5 / Qwen / Llama backbone)\n","# For demonstration & speed, we use T5-base / Qwen architecture\n","MODEL_BACKBONE = \"google/flan-t5-base\"  # Can also be Llama-3-8B / Qwen-2.5-14B\n","print(f\"[INFO] Loading Frozen Generator Backbone: {MODEL_BACKBONE}...\")\n","\n","tokenizer = AutoTokenizer.from_pretrained(MODEL_BACKBONE)\n","model = AutoModelForSeq2SeqLM.from_pretrained(\n","    MODEL_BACKBONE,\n","    output_attentions=True,   # Required for Attention Entropy (σ_attn)\n","    output_hidden_states=True # Required for Hidden State Projections\n",").to(device)\n","model.eval()\n","\n","print(\"✅ Backbone LLM loaded with White-Box Signal Access!\")\n","\n","# 3. Epistemic Uncertainty Extraction Function\n","def extract_epistemic_signals(query_text):\n","    \"\"\"\n","    Extracts single-pass internal model uncertainty signals:\n","    - Input Perplexity (σ_ppl)\n","    - Attention Entropy (σ_attn)\n","    - Token Log-Probability Dispersion\n","    \"\"\"\n","    input_ids = tokenizer.encode(query_text, return_tensors=\"pt\").to(device)\n","\n","    with torch.no_grad():\n","        outputs = model(input_ids=input_ids, decoder_input_ids=input_ids)\n","        logits = outputs.logits  # [batch, seq_len, vocab_size]\n","        attentions = outputs.encoder_attentions  # Tuple of layer attention tensors\n","\n","    # A. Calculate Input Perplexity (σ_ppl)\n","    log_probs = F.log_softmax(logits, dim=-1)\n","    # Gather target log-probs\n","    target_log_probs = log_probs[0, range(input_ids.shape[1]-1), input_ids[0, 1:]]\n","    neg_log_likelihood = -target_log_probs.mean()\n","    perplexity = torch.exp(neg_log_likelihood).item()\n","\n","    # B. Calculate Token Log-Prob Dispersion\n","    probs = F.softmax(logits, dim=-1)\n","    top2_probs, _ = torch.topk(probs, k=2, dim=-1)\n","    # Margin between top-1 and top-2 token predictions\n","    margin = (top2_probs[0, :, 0] - top2_probs[0, :, 1]).mean().item()\n","    log_prob_dispersion = torch.std(target_log_probs).item()\n","\n","    # C. Calculate Attention Entropy across Encoder Layers (σ_attn)\n","    # Layer attentions shape: [batch, num_heads, seq_len, seq_len]\n","    layer_entropies = []\n","    for layer_attn in attentions:\n","        # Calculate Shannon Entropy: -sum(p * log(p))\n","        p = layer_attn + 1e-9  # Epsilon for numerical stability\n","        entropy = -torch.sum(p * torch.log(p), dim=-1).mean().item()\n","        layer_entropies.append(entropy)\n","\n","    mean_attention_entropy = float(np.mean(layer_entropies))\n","\n","    # Composite Feature Vector\n","    feature_vector = {\n","        \"query\": query_text,\n","        \"sigma_ppl\": round(perplexity, 4),\n","        \"sigma_attn_entropy\": round(mean_attention_entropy, 4),\n","        \"log_prob_dispersion\": round(log_prob_dispersion, 4),\n","        \"top_margin\": round(margin, 4)\n","    }\n","\n","    return feature_vector\n","\n","# 4. Test Epistemic Sensing on Sample Queries\n","print(\"\\n======================================================================\")\n","print(\" TESTING EPISTEMIC SENSING ENGINE ON QUERIES\")\n","print(\"======================================================================\")\n","\n","test_queries = [\n","    \"When was Universiti Teknologi Malaysia founded?\",  # Simple Factoid\n","    \"Analyze the causal relationship between national GDP growth and trade tariff adjustments in Southeast Asia.\", # Complex Reasoning\n","    \"Who directed the movie Inception in 2010?\" # Popular Factoid\n","]\n","\n","for q in test_queries:\n","    signals = extract_epistemic_signals(q)\n","    print(f\"\\nQuery: '{signals['query']}'\")\n","    print(f\" ➜ Input Perplexity (σ_ppl)       : {signals['sigma_ppl']}\")\n","    print(f\" ➜ Attention Entropy (σ_attn)      : {signals['sigma_attn_entropy']}\")\n","    print(f\" ➜ Log-Prob Dispersion             : {signals['log_prob_dispersion']}\")\n","    print(f\" ➜ Top Token Margin                : {signals['top_margin']}\")\n","    print(\"-\" * 65)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":912,"referenced_widgets":["44379a9548c345d68b42fa1a699026b6","aa6bc6b40a2149a486b627266f07823b","f28c15a05e214fb992e1f0ab3958e237","53581d68c11946669811f1712fe8daeb","1297800ecec447ddb95816b9e40eefad","6d0429f1f5a848be97ecc91c5a0672d5","18320e3dfa50445b84f8983b4b581872","4f97cd2d95f84a2c83927e3e84d59863","0e9dc8bd22a043ce8132c95376f035da","9f20d3b9200c466dbe1839a75f9949c9","d4a9650137d440ba9d9f98364fcccaba","360fdac2adcc41a19572f6aae912331d","b3ea9e3254024e38b67f437f4c92793f","3a1b9778e7f24561b23e80d19d907de2","1dd728925ca244d78864104fa27c6702","ffc64b77dfb64fd2bf8ff3aa74bfa95b","4b900e934c4c49d0870867124f20d72c","4bcd375da994451e936fbca266acd985","b49193161dc44929b9f507552661f491","01ca5e89f8404b47b2a9b383cbba4783","fcacc2ab62884b2f8ac774b81937cda1","028f63aa201649a4bcbd43f951269e4c","b7bea0f7217f4631bbd9123d8c1667b0","c87a8497a46f488a9d63d9edb8722287","450ec4948f40454e8c6e89ac1b58633a","46443834695d41a3952b34333917888f","3b0e32e121964064acce56bbd8204967","04687676a869461188bf980558bf3543","4cd72b3710aa4cd9b3a6ef34f4b00834","031bb4f60d1648a48aaa5642b0518583","3d6ee4a7d0f8452995582841e73b6e27","c84aa9510cda45628a4e1389ebe038d1","ae9df3e5fdb442928580d84f3689b013","2e