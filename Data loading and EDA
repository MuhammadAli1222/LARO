n=1.039 | Margin=0.287\n","   ➜ Reward Matrix  :\n","       • Option 0 (SKIP)            : -0.0125\n","       • Option 1 (LEXICAL_BM25)    : -0.0095\n","       • Option 2 (SEMANTIC_DENSE)  : -0.0323\n","       • Option 3 (REWRITE_RETRIEVE) : -0.0411\n","---------------------------------------------------------------------------\n","\n","🎯 [ACTION SPACE OPTION: SEMANTIC_DENSE] (Total in Class: 76)\n","   ➜ Benchmark Task : NQ\n","   ➜ Query Text     : \"where are the giant redwoods located in california\"\n","   ➜ Epistemic Cues : σ_ppl=8.7415 | σ_attn=1.1569 | Margin=0.3827\n","   ➜ Reward Matrix  :\n","       • Option 0 (SKIP)            : -0.0048\n","       • Option 1 (LEXICAL_BM25)    : -0.0306\n","       • Option 2 (SEMANTIC_DENSE)  : 0.9781\n","       • Option 3 (REWRITE_RETRIEVE) : -0.0473\n","---------------------------------------------------------------------------\n","\n","🎯 [ACTION SPACE OPTION: REWRITE_RETRIEVE] (Total in Class: 20)\n","   ➜ Benchmark Task : NQ\n","   ➜ Query Text     : \"who is doing 2018 super bowl half time show\"\n","   ➜ Epistemic Cues : σ_ppl=137.7169 | σ_attn=0.9 | Margin=0.1028\n","   ➜ Reward Matrix  :\n","       • Option 0 (SKIP)            : -0.0092\n","       • Option 1 (LEXICAL_BM25)    : -0.007\n","       • Option 2 (SEMANTIC_DENSE)  : -0.0397\n","       • Option 3 (REWRITE_RETRIEVE) : 0.9635\n","---------------------------------------------------------------------------\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"zlCQhoGwqNKv"},"id":"zlCQhoGwqNKv","execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"dM8dBWV4qvUG"},"id":"dM8dBWV4qvUG","execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"wdlb7_RbqvQ-"},"id":"wdlb7_RbqvQ-","execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Step 3: 4-Class LARO Policy Training Script"],"metadata":{"id":"FB373i8Sqv5w"},"id":"FB373i8Sqv5w"},{"cell_type":"code","source":["# ==============================================================================\n","# STEP 3: TRAIN 4-CLASS LARO POLICY NETWORK VIA BEHAVIORAL CLONING\n","# Objective 1: Section 3.2.1.3 (Multi-Action Controller Optimization)\n","# ==============================================================================\n","!pip install -q sentence-transformers scikit-learn matplotlib seaborn\n","\n","import os\n","import json\n","import torch\n","import numpy as np\n","import pandas as pd\n","import torch.nn as nn\n","import torch.optim as optim\n","from torch.utils.data import Dataset, DataLoader\n","from sklearn.model_selection import train_test_split\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.metrics import classification_report, confusion_matrix\n","from sklearn.utils.class_weight import compute_class_weight\n","from sentence_transformers import SentenceTransformer\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","# 1. Setup & Paths\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","BASE_DIR = '/content/drive/My Drive/Objective 1'\n","SUPERVISION_PATH = os.path.join(BASE_DIR, 'laro_supervision', 'laro_oracle_supervision_4class_2000.jsonl')\n","POLICY_MODEL_PATH = os.path.join(BASE_DIR, 'laro_supervision', 'laro_4class_policy_controller.pt')\n","\n","print(\"======================================================================\")\n","print(\" 1. LOADING SUPERVISION DATASET & COMPUTING FEATURE MATRIX\")\n","print(\"======================================================================\")\n","\n","# Load JSONL\n","records = []\n","with open(SUPERVISION_PATH, 'r', encoding='utf-8') as f:\n","    for line in f:\n","        records.append(json.loads(line))\n","\n","df_data = pd.DataFrame(records)\n","print(f\"✅ Loaded {len(df_data):,} annotated samples.\")\n","\n","# Compute Query Embeddings (384-d semantic representation)\n","print(\"[INFO] Encoding queries using sentence-transformers...\")\n","encoder = SentenceTransformer(\"sentence-transformers/all-MiniLM-L6-v2\", device=device)\n","queries = df_data['query'].tolist()\n","query_embeddings = encoder.encode(queries, batch_size=128, show_progress_bar=True, convert_to_numpy=True)\n","\n","# Standardize Epistemic Cues (4 features)\n","epistemic_features = df_data[['sigma_ppl', 'sigma_attn_entropy', 'log_prob_dispersion', 'top_margin']].values\n","scaler = StandardScaler()\n","epistemic_scaled = scaler.fit_transform(epistemic_features)\n","\n","# Combine: X = [Query Vector (384) + Scaled Epistemic Signals (4)] = 388 features\n","X_combined = np.hstack([query_embeddings, epistemic_scaled])\n","\n","# Map Labels to Integers 0-3\n","label_map = {\n","    \"SKIP\": 0,\n","    \"LEXICAL_BM25\": 1,\n","    \"SEMANTIC_DENSE\": 2,\n","    \"REWRITE_RETRIEVE\": 3\n","}\n","y_labels = df_data['oracle_action'].map(label_map).values\n","\n","# 2. Train / Validation Split (80% Train, 20% Val)\n","X_train, X_val, y_train, y_val = train_test_split(\n","    X_combined, y_labels, test_size=0.20, random_state=42, stratify=y_labels\n",")\n","\n","# Compute Class Weights to handle imbalanced minority actions (Dense & Rewrite)\n","class_weights = compute_class_weight(class_weight='balanced', classes=np.unique(y_train), y=y_train)\n","class_weights_tensor = torch.tensor(class_weights, dtype=torch.float32).to(device)\n","\n","print(f\"✅ Feature Matrix Dimension: {X_combined.shape}\")\n","print(f\"✅ Class Weights (Balanced): {class_weights.round(3)}\")\n","\n","# PyTorch Dataset\n","class LARO4ClassDataset(Dataset):\n","    def __init__(self, X, y):\n","        self.X = torch.tensor(X, dtype=torch.float32)\n","        self.y = torch.tensor(y, dtype=torch.long)\n","    def __len__(self):\n","        return len(self.X)\n","    def __getitem__(self, idx):\n","        return self.X[idx], self.y[idx]\n","\n","train_loader = DataLoader(LARO4ClassDataset(X_train, y_train), batch_size=32, shuffle=True)\n","val_loader = DataLoader(LARO4ClassDataset(X_val, y_val), batch_size=32, shuffle=False)\n","\n","# 3. Define 4-Class LARO Policy Architecture (Section 3.2.1.3 MLP)\n","class LARO4ClassPolicyMLP(nn.Module):\n","    def __init__(self, input_dim, num_classes=4):\n","        super(LARO4ClassPolicyMLP, self).__init__()\n","        self.network = nn.Sequential(\n","            nn.Linear(input_dim, 256),\n","            nn.LayerNorm(256),\n","            nn.ReLU(),\n","            nn.Dropout(0.3),\n","            nn.Linear(256, 128),\n","            nn.LayerNorm(128),\n","            nn.ReLU(),\n","            nn.Dropout(0.2),\n","            nn.Linear(128, num_classes)\n","        )\n","    def forward(self, x):\n","        return self.network(x)\n","\n","input_dimension = X_combined.shape[1]\n","policy_net = LARO4ClassPolicyMLP(input_dim=input_dimension, num_classes=4).to(device)\n","\n","# Class-Weighted Cross-Entropy Loss\n","criterion = nn.CrossEntropyLoss(weight=class_weights_tensor)\n","optimizer = optim.AdamW(policy_net.parameters(), lr=1e-3, weight_decay=1e-4)\n","\n","# 4. Training Loop\n","print(\"\\n======================================================================\")\n","print(\" 2. TRAINING 4-CLASS LARO POLICY CONTROLLER (BEHAVIORAL CLONING)\")\n","print(\"======================================================================\")\n","\n","EPOCHS = 40\n","train_losses, val_accuracies = [], []\n","\n","for epoch in range(1, EPOCHS + 1):\n","    policy_net.train()\n","    running_loss = 0.0\n","    for batch_x, batch_y in train_loader:\n","        batch_x, batch_y = batch_x.to(device), batch_y.to(device)\n","\n","        optimizer.zero_grad()\n","        outputs = policy_net(batch_x)\n","        loss = criterion(outputs, batch_y)\n","        loss.backward()\n","        optimizer.step()\n","        running_loss += loss.item() * batch_x.size(0)\n","\n","    epoch_loss = running_loss / len(X_train)\n","    train_losses.append(epoch_loss)\n","\n","    # Validation\n","    policy_net.eval()\n","    correct, total = 0, 0\n","    with torch.no_grad():\n","        for batch_x, batch_y in val_loader:\n","            batch_x, batch_y = batch_x.to(device), batch_y.to(device)\n","            preds = torch.argmax(policy_net(batch_x), dim=1)\n","            correct += (preds == batch_y).sum().item()\n","            total += batch_y.size(0)\n","\n","    val_acc = (correct / total) * 100\n","    val_accuracies.append(val_acc)\n","\n","    if epoch % 5 == 0 or epoch == 1:\n","        print(f\"Epoch [{epoch:02d}/{EPOCHS}] | Train Loss: {epoch_loss:.4f} | Val Orchestration Accuracy: {val_acc:.2f}%\")\n","\n","# Save Trained Policy Weights\n","torch.save({\n","    'model_state_dict': policy_net.state_dict(),\n","    'scaler': scaler,\n","    'input_dim': input_dimension,\n","    'label_map': label_map\n","}, POLICY_MODEL_PATH)\n","\n","print(f\"\\n✅ LARO 4-Class Policy Weights Saved At: {POLICY_MODEL_PATH}\")\n","\n","# 5. Final Model Evaluation & Confusion Matrix\n","print(\"\\n======================================================================\")\n","print(\" 3. FINAL MODEL EVALUATION & CONFUSION MATRIX\")\n","print(\"======================================================================\")\n","\n","policy_net.eval()\n","all_preds, all_targets = [], []\n","with torch.no_grad():\n","    for batch_x, batch_y in val_loader:\n","        batch_x = batch_x.to(device)\n","        preds = torch.argmax(policy_net(batch_x), dim=1).cpu().numpy()\n","        all_preds.extend(preds)\n","        all_targets.extend(batch_y.numpy())\n","\n","target_names = [\"SKIP (a0)\", \"LEXICAL (a1)\", \"DENSE (a2)\", \"REWRITE (a3)\"]\n","print(\"\\n--- Classification Report ---\")\n","print(classification_report(all_targets, all_preds, target_names=target_names, zero_division=0))\n","\n","# Plot Confusion Matrix\n","cm = confusion_matrix(all_targets, all_preds)\n","plt.figure(figsize=(7, 6))\n","sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=target_names, yticklabels=target_names)\n","plt.title(\"LARO Policy Network Con