ted and will be removed in v0.14.0. Assign the `y` variable to `hue` and set `legend=False` for the same effect.\n","\n","  sns.barplot(data=df_entities, x=\"Frequency\", y=\"Entity Type\", palette=\"magma\")\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","[INFO 4/4] Evaluating Content Redundancy (TF-IDF Cosine Similarity)...\n","\n","✅ Estimated Near-Duplicate Rate (Cosine Similarity > 0.9): 0.01%\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x450 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","🎉 EDA Complete! All figures and Table 4.1 have been saved to Drive at:\n","/content/drive/My Drive/Objective 1/eda_outputs\n"]}],"source":["# ==============================================================================\n","# CELL 3: EXPLORATORY DATA ANALYSIS (EDA) - CHAPTER 4, SECTION 4.3\n","# ==============================================================================\n","!pip install -q transformers spacy scikit-learn matplotlib seaborn tqdm\n","!python -m spacy download en_core_web_sm -q\n","\n","import os\n","import json\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from tqdm import tqdm\n","from collections import Counter\n","from transformers import AutoTokenizer\n","import spacy\n","from sklearn.feature_extraction.text import TfidfVectorizer\n","from sklearn.metrics.pairwise import cosine_similarity\n","\n","# Set plot style for academic thesis publication\n","sns.set_theme(style=\"whitegrid\")\n","plt.rcParams[\"font.sans-serif\"] = \"DejaVu Sans\"\n","\n","# Output directory in Drive for EDA artifacts\n","EDA_DIR = '/content/drive/My Drive/Objective 1/eda_outputs'\n","os.makedirs(EDA_DIR, exist_ok=True)\n","\n","# ------------------------------------------------------------------------------\n","# 1. PASSAGE LENGTH DISTRIBUTION & TABLE 4.1 SUMMARY STATS\n","# ------------------------------------------------------------------------------\n","print(\"[INFO 1/4] Calculating Passage Length Statistics over 100,000 documents...\")\n","\n","SAMPLE_SIZE = 100000\n","char_lengths = []\n","word_lengths = []\n","sample_texts = []\n","\n","for i, doc in enumerate(tqdm(stream_wikipedia(file_path, max_docs=SAMPLE_SIZE), total=SAMPLE_SIZE)):\n","    text = doc.get(\"text\", \"\")\n","    if isinstance(text, list):\n","        text = \" \".join(text)\n","\n","    c_len = len(text)\n","    w_len = len(text.split())\n","\n","    char_lengths.append(c_len)\n","    word_lengths.append(w_len)\n","\n","    if i < 5000:  # Retain smaller sub-sample for token/NLP analyses\n","        sample_texts.append(text)\n","\n","# Generate Table 4.1\n","df_table_4_1 = pd.DataFrame({\n","    \"Statistic\": [\"Mean\", \"Min\", \"Max\"],\n","    \"Character Count\": [f\"{np.mean(char_lengths):,.1f}\", f\"{np.min(char_lengths):,}\", f\"{np.max(char_lengths):,}\"],\n","    \"Word Count\": [f\"{np.mean(word_lengths):,.1f}\", f\"{np.min(word_lengths):,}\", f\"{np.max(word_lengths):,}\"]\n","})\n","\n","print(\"\\n=========================================================\")\n","print(\" TABLE 4.1: SUMMARY STATISTICS OF RAW PASSAGE LENGTHS\")\n","print(\"=========================================================\")\n","print(df_table_4_1.to_string(index=False))\n","df_table_4_1.to_csv(os.path.join(EDA_DIR, \"table_4_1_summary_stats.csv\"), index=False)\n","\n","# Plot Figure 4.1: Log-Scale Passage Length Distribution\n","plt.figure(figsize=(10, 5))\n","plt.hist(char_lengths, bins=100, log=True, color=\"#5B9BD5\", edgecolor=\"black\", alpha=0.8)\n","plt.title(\"Figure 4.1: Log-Scale Distribution of Passage Lengths in KILT Corpus\", fontsize=12, fontweight='bold')\n","plt.xlabel(\"Characters per Passage\")\n","plt.ylabel(\"Count (Log Scale)\")\n","plt.tight_layout()\n","plt.savefig(os.path.join(EDA_DIR, \"figure_4_1_length_distribution.png\"), dpi=300)\n","plt.show()\n","\n","# ------------------------------------------------------------------------------\n","# 2. VOCABULARY & TOKEN FREQUENCY ANALYSIS (FIGURE 4.2)\n","# ------------------------------------------------------------------------------\n","print(\"\\n[INFO 2/4] Running Token Frequency Analysis (BERT Tokenizer)...\")\n","tokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n","\n","all_tokens = []\n","for text in tqdm(sample_texts[:2000], desc=\"Tokenizing Passages\"):\n","    tokens = tokenizer.tokenize(text.lower())\n","    all_tokens.extend(tokens)\n","\n","top_20_tokens = Counter(all_tokens).most_common(20)\n","df_tokens = pd.DataFrame(top_20_tokens, columns=[\"Token\", \"Frequency\"])\n","\n","plt.figure(figsize=(10, 5))\n","sns.barplot(data=df_tokens, x=\"Frequency\", y=\"Token\", palette=\"viridis\")\n","plt.title(\"Figure 4.2: Top 20 Most Frequent Tokens in Sampled Corpus\", fontsize=12, fontweight='bold')\n","plt.tight_layout()\n","plt.savefig(os.path.join(EDA_DIR, \"figure_4_2_top_tokens.png\"), dpi=300)\n","plt.show()\n","\n","# ------------------------------------------------------------------------------\n","# 3. NAMED ENTITY DENSITY ANALYSIS (FIGURE 4.3)\n","# ------------------------------------------------------------------------------\n","print(\"\\n[INFO 3/4] Extracting Named Entities using SpaCy Pipeline...\")\n","nlp = spacy.load(\"en_core_web_sm\", disable=[\"parser\"])\n","\n","entities = []\n","for doc in tqdm(nlp.pipe(sample_texts[:1000], batch_size=50), total=1000, desc=\"Extracting Entities\"):\n","    for ent in doc.ents:\n","        entities.append(ent.label_)\n","\n","top_10_entities = Counter(entities).most_common(10)\n","df_entities = pd.DataFrame(top_10_entities, columns=[\"Entity Type\", \"Frequency\"])\n","\n","plt.figure(figsize=(10, 5))\n","sns.barplot(data=df_entities, x=\"Frequency\", y=\"Entity Type\", palette=\"magma\")\n","plt.title(\"Fig