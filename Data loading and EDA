dent=2)[:1000])  # Prints first 1000 characters"]},{"cell_type":"code","execution_count":null,"id":"380792c1","metadata":{"id":"380792c1"},"outputs":[],"source":[]},{"cell_type":"markdown","source":["Cell 3: Reusable Memory-Safe Generator Function\n"],"metadata":{"id":"tpESY_Y4CU2Z"},"id":"tpESY_Y4CU2Z"},{"cell_type":"code","execution_count":null,"id":"2f13d7be","metadata":{"id":"2f13d7be","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1785045812930,"user_tz":-480,"elapsed":787,"user":{"displayName":"MUHAMMAD ALI","userId":"01574840028316529342"}},"outputId":"117d216b-8f6e-4c46-c20c-a0a60a9bb9d0"},"outputs":[{"output_type":"stream","name":"stdout","text":["Successfully streamed 100 documents!\n"]}],"source":["def stream_wikipedia(jsonl_path, max_docs=None):\n","    \"\"\"\n","    Yields Wikipedia documents one by one to save RAM.\n","    \"\"\"\n","    with open(jsonl_path, 'r', encoding='utf-8') as f:\n","        for i, line in enumerate(f):\n","            if max_docs is not None and i >= max_docs:\n","                break\n","            yield json.loads(line)\n","\n","# Example usage: Count total tokens/words in first 100 docs\n","sample_count = 0\n","for doc in stream_wikipedia(file_path, max_docs=100):\n","    sample_count += 1\n","\n","print(f\"Successfully streamed {sample_count} documents!\")"]},{"cell_type":"code","execution_count":null,"id":"5d0a20fa","metadata":{"id":"5d0a20fa"},"outputs":[],"source":[]},{"cell_type":"markdown","source":["Run EDA on Streamed Wikipedia Corpus\n"],"metadata":{"id":"D2BxQuNnCPn4"},"id":"D2BxQuNnCPn4"},{"cell_type":"code","execution_count":null,"id":"686a1c39","metadata":{"id":"686a1c39","colab":{"base_uri":"https://localhost:8080/","height":1000,"referenced_widgets":["810cbe31f92e4cca94ce652a54888108","21e2b14e239d41b4b90b8c33a665a1cc","49389614a353432890a8c140cdf9b4da","cb76a025214145ee91944d263fcef68e","1a9cf835e0084cf5845c4d1f1b6f501d","9a5281dc04ee40e49a9d94b7c50223a7","206b8a