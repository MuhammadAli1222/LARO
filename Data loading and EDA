n","source":["Build the FAISS Dense Vector Index"],"metadata":{"id":"HeQgZtqc-7c7"},"id":"HeQgZtqc-7c7"},{"cell_type":"code","source":["# ==============================================================================\n","# STEP 1: FORCE REINSTALL PILLOW & RESTART PYTHON KERNEL\n","# ==============================================================================\n","!pip install --upgrade --force-reinstall pillow -q\n","!pip install --upgrade transformers sentence-transformers faiss-gpu -q\n","\n","import os\n","print(\"\\n======================================================================\")\n","print(\" ✅ PILLOW & TRANSFORMERS SUCCESSFULLY REINSTALLED!\")\n","print(\" 🔄 RESTARTING PYTHON RUNTIME NOW TO CLEAR CACHED RAM MODULES...\")\n","print(\"======================================================================\")\n","\n","# Automatically triggers Colab runtime restart\n","os._exit(0)"],"metadata":{"id":"sng3W16r_Tq8"},"id":"sng3W16r_Tq8","execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ==============================================================================\n","# STEP 2: CONSTRUCT FAISS DENSE VECTOR INDEX (E5-LARGE-V2)\n","# Objective 1: Dense Retrieval Substrate\n","# ==============================================================================\n","import os\n","import json\n","import torch\n","import faiss\n","import torch.nn.functional as F\n","from tqdm import tqdm\n","from transformers import AutoTokenizer, AutoModel\n","from google.colab import drive\n","\n","# 1. Mount Drive\n","drive.mount('/content/drive', force_remount=True)\n","\n","# 2. Hardware Accelerator Setup\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","print(f\"[INFO] Active Hardware Accelerator: {device.upper()}\")\n","\n","# 3. Paths Configuration\n","BASE_DIR = '/content/drive/My Drive/Objective 1'\n","FULL_CHUNKS_PATH = os.path.join(BASE_DIR, 'full_chunked_corpus', 'kilt_wikipedia_chunks_full.jsonl')\n","\n","FAISS_DIR = os.path.join(BASE_DIR, 'indices', 'faiss')\n","os.makedirs(FAISS_DIR, exist_ok=True)\n","\n","FAISS_INDEX_PATH = os.path.join(FAISS_DIR, 'kilt_e5_large_v2.index')\n","MAPPING_JSON_PATH = os.path.join(FAISS_DIR, 'faiss_id_mapping.json')\n","\n","# 4. Load E5 Model & Fast Tokenizer\n","MODEL_NAME = \"intfloat/e5-large-v2\"\n","print(f\"[INFO] Loading Dense Model & Tokenizer ({MODEL_NAME})...\")\n","\n","tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, use_fast=True)\n","model = AutoModel.from_pretrained(MODEL_NAME).to(device)\n","model.eval()\n","\n","EMBEDDING_DIM = 1024  # Output dimension of e5-large-v2\n","\n","# 5. Initialize FAISS Index (Inner Product on Normalized Vectors = Cosine Similarity)\n","faiss_index = faiss.IndexFlatIP(EMBEDDING_DIM)\n","if device == \"cuda\":\n","    res = faiss.StandardGpuResources()\n","    faiss_index = faiss.index_cpu_to_gpu(res, 0, faiss_index)\n","\n","print(f\"✅ FAISS Index initialized on {device.upper()} (Dimension: {EMBEDDING_DIM})\")\n","\n","# 6. Mean Pooling Function for E5 Embeddings\n","def mean_pooling(model_output, attention_mask):\n","    token_embeddings = model_output[0]\n","    input_mask_expanded = attention_mask.unsqueeze(-1).expand(token_embeddings.size()).float()\n","    return torch.sum(token_embeddings * input_mask_expanded, 1) / torch.clamp(input_mask_expanded.sum(1), min=1e-9)\n","\n","# 7. GPU Batch Processing Loop\n","BATCH_SIZE = 256\n","chunk_id_map = {}\n","\n","text_batch = []\n","chunk_id_batch = []\n","total_passages_indexed = 0\n","\n","print(\"\\n======================================================================\")\n","print(\" STARTING FP16 GPU DENSE EMBEDDING & FAISS INDEXING\")\n","print(\"======================================================================\")\n","\n","with open(FULL_CHUNKS_PATH, 'r', encoding='utf-8') as in_f:\n","    for line in tqdm(in_f, total=21113601, desc=\"Embedding Passages\"):\n","        chunk = json.loads(line)\n","        chunk_id = chunk.get(\"chunk_id\")\n","        text = chunk.get(\"text\", \"\")\n","\n","        # E5 Prefix requirement\n","        text_batch.append(f\"passage: {text}\")\n","        chunk_id_batch.append(chunk_id)\n","\n","        if len(text_batch) >= BATCH_SIZE:\n","            encoded_input = tokenizer(\n","                text_batch,\n","                padding=True,\n","                truncation=True,\n","                max_length=256,\n","                return_tensors='pt'\n","            ).to(device)\n","\n","            with torch.no_grad(), torch.amp.autocast('cuda'):\n","                model_output = model(**encoded_input)\n","                sentence_embeddings = mean_pooling(model_output, encoded_input['attention_mask'])\n","                sentence_embeddings = F.normalize(sentence_embeddings, p=2, dim=1)\n","\n","            embeddings_np = sentence_embeddings.cpu().numpy().astype('float32')\n","            faiss_index.add(embeddings_np)\n","\n","            for idx, cid in enumerate(chunk_id_batch):\n","                chunk_id_map[total_passages_indexed + idx] = cid\n","\n","            total_passages_indexed += len(text_batch)\n","            text_batch.clear()\n","            chunk_id_batch.clear()\n","\n","    # Remaining batch\n","    if text_batch:\n","        encoded_input = tokenizer(text_batch, padding=True, truncation=True, max_length=256, return_tensors='pt').to(device)\n","        with torch.no_grad(), torch.amp.autocast('cuda'):\n","            model_output = model(**encoded_input)\n","            sentence_embeddings = mean_pooling(model_output, encoded_input['attention_mask'])\n","            sentence_embeddings = F.normalize(sentence_embeddings, p=2, dim=1)\n","\n","        embeddings_np = sentence_embeddings.cpu().numpy().astype('float32')\n","        faiss_index.add(embeddings_np)\n","\n","        for idx, cid in enumerate(chunk_id_batch):\n","            chunk_id_map[total_passages_indexed + idx] = cid\n","        total_passages_indexed += len(text_batch)\n","\n","# 8. Save 