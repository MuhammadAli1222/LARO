n = torch.std(target_log_probs).item()\n","\n","    layer_entropies = []\n","    for layer_attn in attentions:\n","        p = layer_attn + 1e-9\n","        entropy = -torch.sum(p * torch.log(p), dim=-1).mean().item()\n","        layer_entropies.append(entropy)\n","\n","    mean_attention_entropy = float(np.mean(layer_entropies))\n","\n","    return {\n","        \"query\": query_text,\n","        \"sigma_ppl\": round(perplexity, 4),\n","        \"sigma_attn_entropy\": round(mean_attention_entropy, 4),\n","        \"log_prob_dispersion\": round(log_prob_dispersion, 4),\n","        \"top_margin\": round(margin, 4)\n","    }\n","\n","def check_exact_match(prediction_text, ground_truths):\n","    pred_clean = prediction_text.lower().strip()\n","    for gt in ground_truths:\n","        if gt and (gt.lower().strip() in pred_clean or pred_clean in gt.lower().strip()):\n","            return 1.0\n","    return 0.0\n","\n","# 5. Extract 500 TriviaQA Queries with Robust Answer Parsing\n","print(\"======================================================================\")\n","print(\" FETCHING & PARSING TRIVIAQA QUERIES (500 SAMPLES)\")\n","print(\"======================================================================\")\n","\n","ds_trivia = load_dataset(\"facebook/kilt_tasks\", \"triviaqa_support_only\", split=\"validation\")\n","trivia_pool = []\n","\n","for item in ds_trivia:\n","    q_text = item.get(\"input\", \"\")\n","    answers = []\n","\n","    # Extract answers from KILT outputs\n","    for alt in item.get(\"output\", []):\n","        if isinstance(alt, dict):\n","            if alt.get(\"answer\"):\n","                answers.append(str(alt[\"answer\"]))\n","            if \"meta\" in alt and isinstance(alt[\"meta\"], dict):\n","                raw_ans = alt[\"meta\"].get(\"raw_annotation\", {}).get(\"answer\", \"\")\n","                if raw_ans:\n","                    answers.append(str(raw_ans))\n","\n","    answers = list(set([a for a in answers if a.strip()]))\n","\n","    if q_text and answers:\n","        trivia_pool.append({\n","            \"task\": \"triviaqa\",\n","            \"query\": q_text,\n","            \"answers\": answers\n","        })\n","        if len(trivia_pool) >= 500:\n","            break\n","\n","print(f\"✅ Extracted {len(trivia_pool)} TriviaQA queries!\")\n","\n","# 6. Simulate Trajectories for TriviaQA\n","print(\"\\n======================================================================\")\n","print(\" SIMULATING TRAJECTORIES FOR TRIVIAQA\")\n","print(\"======================================================================\")\n","\n","LAMBDA_LATENCY = 0.05\n","trivia_records = []\n","\n","for item in tqdm(trivia_pool, desc=\"Simulating TriviaQA\"):\n","    q_text = item[\"query\"]\n","    gts = item[\"answers\"]\n","\n","    signals = extract_epistemic_signals(q_text)\n","\n","    # Action 0: SKIP\n","    t0 = time.time()\n","    input_ids = tokenizer.encode(q_text, return_tensors=\"pt\").to(device)\n","    with torch.no_grad():\n","        gen_out = model.generate(input_ids, max_new_tokens=30)\n","        ans_skip = tokenizer.decode(gen_out[0], skip_special_tokens=True)\n","    lat_skip = time.time() - t0\n","    acc_skip = check_exact_match(ans_skip, gts)\n","    reward_skip = acc_skip - (LAMBDA_LATENCY * lat_skip)\n","\n","    # Action 1: SPARSE-TOP5\n","    t0 = time.time()\n","    hits = bm25_searcher.search(q_text, k=5)\n","    retrieved_texts = []\n","    for h in hits:\n","        doc_obj = bm25_searcher.doc(h.docid)\n","        if doc_obj and doc_obj.raw():\n","            try:\n","                retrieved_texts.append(json.loads(doc_obj.raw()).get(\"contents\", \"\"))\n","            except:\n","                retrieved_texts.append(doc_obj.contents())\n","\n","    augmented_prompt = f\"Context: {' '.join(retrieved_texts)[:1000]} Query: {q_text}\"\n","    input_ids_aug = tokenizer.encode(augmented_prompt, return_tensors=\"pt\", truncation=True, max_length=512).to(device)\n","    with torch.no_grad():\n","        gen_out_sparse = model.generate(input_ids_aug, max_new_tokens=30)\n","        ans_sparse = tokenizer.decode(gen_out_sparse[0], skip_special_tokens=True)\n","    lat_sparse = time.time() - t0\n","    acc_sparse = check_exact_match(ans_sparse, gts)\n","    reward_sparse = acc_sparse - (LAMBDA_LATENCY * lat_sparse)\n","\n","    rewards = {\"SKIP\": reward_skip, \"SPARSE_TOP5\": reward_sparse}\n","    optimal_action = max(rewards, key=rewards.get)\n","\n","    trivia_records.append({\n","        \"query\": q_text,\n","        \"task\": item[\"task\"],\n","        \"sigma_ppl\": signals[\"sigma_ppl\"],\n","        \"sigma_attn_entropy\": signals[\"sigma_attn_entropy\"],\n","        \"log_prob_dispersion\": signals[\"log_prob_dispersion\"],\n","        \"top_margin\": signals[\"top_margin\"],\n","        \"oracle_action\": optimal_action,\n","        \"reward_skip\": round(reward_skip, 4),\n","        \"reward_sparse\": round(reward_sparse, 4)\n","    })\n","\n","# 7. Append TriviaQA records to the Drive file\n","with open(ORACLE_DATASET_PATH, 'a', encoding='utf-8') as f:\n","    for rec in trivia_records:\n","        f.write(json.dumps(rec) + '\\n')\n","\n","print(f\"\\n✅ Successfully appended TriviaQA! Updated dataset on Drive.\")\n","\n","# 8. Final Verification & Stratified Display\n","records = []\n","with open(ORACLE_DATASET_PATH, 'r', encoding='utf-8') as f:\n","    for line in f:\n","        records.append(json.loads(line))\n","\n","df_final = pd.DataFrame(records)\n","\n","print(\"\\n======================================================================\")\n","print(\" FINAL FULL 2,000-QUERY SUPERVISION DATASET SUMMARY\")\n","print(\"======================================================================\")\n","print(f\"Total Annotated Queries: {len(df_final):,}\")\n","\n","print(\"\\n--- Task Split Breakdown ---\")\n","print(pd.crosstab(df_final['task'], df_final['oracle_action'], margins=True).to_string())\n","\n","print(\"\\n===