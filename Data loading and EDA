 seaborn pandas numpy tqdm\n","import nltk\n","nltk.download('punkt', quiet=True)\n","nltk.download('punkt_tab', quiet=True)\n","\n","import os\n","import re\n","import json\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from tqdm import tqdm\n","from collections import Counter, defaultdict\n","from nltk.tokenize import sent_tokenize, word_tokenize\n","\n","# Setup output directory in Drive\n","WIKI_EDA_DIR = '/content/drive/My Drive/Objective 1/wiki_eda_outputs'\n","os.makedirs(WIKI_EDA_DIR, exist_ok=True)\n","\n","sns.set_theme(style=\"whitegrid\")\n","plt.rcParams[\"font.sans-serif\"] = \"DejaVu Sans\"\n","\n","# ------------------------------------------------------------------------------\n","# 1. SCANNING STRUCTURAL ARTIFACTS & FORMATTING NOISE\n","# ------------------------------------------------------------------------------\n","print(\"[INFO 1/4] Scanning structural noise & markup across 30,000 Wikipedia documents...\")\n","\n","artifact_patterns = {\n","    \"Section Headers (Section::::)\": re.compile(r'Section::::'),\n","    \"Bullet Markers (BULLET::::)\": re.compile(r'BULLET::::'),\n","    \"Numeric Citations ([1], [2])\": re.compile(r'\\[\\d+\\]'),\n","    \"Web URLs / Hyperlinks\": re.compile(r'https?://\\S+|www\\.\\S+'),\n","    \"HTML Tags (<p>, <div>, etc)\": re.compile(r'<[^>]+>'),\n","    \"LaTeX / Math Syntax\": re.compile(r'\\\\math|\\\\frac|\\{\\$'),\n","    \"Parenthetical Years (19xx-20xx)\": re.compile(r'\\(\\s*\\d{4}\\s*[-–—]?\\s*\\d{0,4}\\s*\\)'),\n","    \"Non-ASCII Unicode Characters\": re.compile(r'[^\\x00-\\x7F]+')\n","}\n","\n","SAMPLE_LIMIT = 30000\n","\n","artifact_counts = defaultdict(int)\n","doc_char_lens = []\n","doc_word_s = []\n","paragraphs_per_doc = []\n","sentences_per_doc = []\n","words_per_sentence = []\n","\n","stub_count = 0        # < 50 words\n","medium_count = 0      # 50 - 1000 words\n","long_count = 0        # > 1000 words\n","\n","for i, doc in enumerate(tqdm(stream_wikipedia(file_path, max_docs=SAMPLE_LIMIT), total=SAMPLE_LIMIT, desc=\"Processing Wiki Stream\")):\n","    text = doc.get(\"text\", \"\")\n","    if isinstance(text, list):\n","        text = \" \".join(text)\n","\n","    if not text.strip():\n","        continue\n","\n","    # Check artifact occurrences\n","    for name, pattern in artifact_patterns.items():\n","        if pattern.search(text):\n","            artifact_counts[name] += 1\n","\n","    # Word & Character Counts\n","    c_len = len(text)\n","    words = text.split()\n","    w_len = len(words)\n","\n","    doc_char_lens.append(c_len)\n","    doc_word_s.append(w_len)\n","\n","    # Article Bucket Classification\n","    if w_len < 50:\n","        stub_count += 1\n","    elif w_len <= 1000:\n","        medium_count += 1\n","    else:\n","        long_count += 1\n","\n","    # Paragraph Analysis (splitting on double newlines or Section markers)\n","    paragraphs = [p for p in re.split(r'\\n+|\\s*Section::::', text) if p.strip()]\n","    paragraphs_per_doc.append(len(paragraphs))\n","\n","    # Sentence Mechanics (Sampled on first 5,000 docs for execution speed)\n","    if i < 5000:\n","        sents = sent_tokenize(text)\n","        sentences_per_doc.append(len(sents))\n","        for s in sents:\n","            sw = s.split()\n","            if len(sw) > 0:\n","                words_per_sentence.append(len(sw))\n","\n","# ------------------------------------------------------------------------------\n","# 2. PRINT DIAGNOSTIC TABLES\n","# ------------------------------------------------------------------------------\n","print(\"\\n======================================================================\")\n","print(\" 1. STRUCTURAL NOISE PREVALENCE IN RAW WIKIPEDIA\")\n","print(\"======================================================================\")\n","df_artifacts = pd.DataFrame([\n","    {\"Artifact Type\": name,\n","     \"Affected Documents\": count,\n","     \"Prevalence (%)\": f\"{(count / SAMPLE_LIMIT) * 100:.2f}%\"}\n","    for name, count in artifact_counts.items()\n","]).sort_values(by=\"Affected Documents\", ascending=False)\n","print(df_artifacts.to_string(index=False))\n","df_artifacts.to_csv(os.path.join(WIKI_EDA_DIR, \"wiki_noise_prevalence.csv\"), index=False)\n","\n","print(\"\\n======================================================================\")\n","print(\" 2. LENGTH PERCENTILE DISTRIBUTION (CHARACTERS & WORDS)\")\n","print(\"======================================================================\")\n","percentiles = [10, 25, 50, 75, 90, 95, 99]\n","df_percentiles = pd.DataFrame({\n","    \"Percentile\": [f\"p{p}\" for p in percentiles],\n","    \"Character Length\": np.percentile(doc_char_lens, percentiles).astype(int),\n","    \"Word Count\": np.percentile(doc_word_s, percentiles).astype(int)\n","})\n","print(df_percentiles.to_string(index=False))\n","df_percentiles.to_csv(os.path.join(WIKI_EDA_DIR, \"wiki_length_percentiles.csv\"), index=False)\n","\n","print(\"\\n======================================================================\")\n","print(\" 3. ARTICLE SCALE CATEGORIZATION\")\n","print(\"======================================================================\")\n","print(f\"Stubs (< 50 words)          : {stub_count:,} ({stub_count/SAMPLE_LIMIT*100:.2f}%)\")\n","print(f\"Standard (50 - 1,000 words)  : {medium_count:,} ({medium_count/SAMPLE_LIMIT*100:.2f}%)\")\n","print(f\"Long-Form (> 1,000 words)   : {long_count:,} ({long_count/SAMPLE_LIMIT*100:.2f}%)\")\n","\n","print(\"\\n======================================================================\")\n","print(\" 4. PARAGRAPH & SENTENCE MECHANICS\")\n","print(\"======================================================================\")\n","print(f\"Mean Paragraphs per Article : {np.mean(paragraphs_per_doc):.2f} (Median: {np.median(paragraphs_per_doc):.1f})\")\n","print(f\"Mean Sentences per Article  : {np.mean(sentences_per_doc):.2f} (Median: {np.median(sentences_per_doc):.1f})\")\n","print(f\"Mean Words per Sentence     : {np.mean(words_per_sentence):.2f} (Median: {np.median(words_per_sentence):.1f})\")\n","print(f\"95th Percentile Words/Sent  : {np.percentile(words_per_sentence, 95):.1f} words\")\n","\n","# ------------------------------------------------------------------------------\n","# 3. GENERATE DIAGNOSTIC FIGURES\n","# ------------------------------------------------------------------------------\n","# Figure A: Noise Prevalence Bar Chart\n","plt.figure(figsize=(10, 5))\n","sns.barplot(data=df_artifacts, x=\"Affected Documents\", y=\"Artifact Type\", palette=\"rocket\")\n","plt.title(\"Prevalence of Structural Artifacts in Raw Wikipedia Corpus\", fontsize=12, fontweight='bold')\n","plt.xlabel(\"Number of Affected Documents (out of 30,000)\")\n","plt.tight_layout()\n","plt.savefig(os.path.join(WIKI_EDA_DIR, \"figure_wiki_noise_prevalence.png\"), dpi=300)\n","plt.show()\n","\n","# Figure B: Article Scale Breakdown Pie Chart\n","plt.figure(figsize=(7, 7))\n","plt.pie([stub_count, medium_count, long_count],\n","        labels=['Stubs (<50 words)', 'Standard (50-1k words)', 'Long-Form (>1k words)'],\n","        autopct='%1.1f%%', startangle=140, colors=['#ff9999','#66b3ff','#99ff99'])\n","plt.title(\"Distribution of Article Length Scales in Wikipedia\", fontsize=12, fontweight='bold')\n","plt.tight_layout()\n","plt.savefig(os.path.join(WIKI_EDA_DIR, \"figure_article_scale_pie.png\"), dpi=300)\n","plt.show()\n","\n","# Figure C: Words per Sentence Distribution\n","plt.figure(figsize=(10, 4.5))\n","sns.histplot(words_per_sentence, bins=60, kde=True, color=\"purple\", binrange=(0, 80))\n","plt.axvline(np.mean(words_per_sentence), color=\"red\", linestyle=\"--\", label=f\"Mean ({np.mean(words_per_sentence):.1f} words)\")\n","plt.axvline(np.median(words_per_sentence), color=\"green\", linestyle=\":\", label=f\"Median ({np.median(words_per_sentence):.1f} words)\")\n","plt.title(\"Distribution of Words per Sentence in Wikipedia P