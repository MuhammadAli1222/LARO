i API Call)\n","# ==============================================================================\n","import os\n","import glob\n","import json\n","import time\n","import torch\n","import numpy as np\n","import torch.nn.functional as F\n","from tqdm import tqdm\n","from datasets import load_dataset\n","\n","# 1. Configure Java 21 for Pyserini\n","jvm_locations = glob.glob('/usr/lib/jvm/**/libjvm.so', recursive=True)\n","if jvm_locations:\n","    j21_path = [p for p in jvm_locations if '21' in p]\n","    chosen_jvm = j21_path[0] if j21_path else jvm_locations[0]\n","    os.environ[\"JVM_PATH\"] = chosen_jvm\n","    java_root = os.path.abspath(os.path.join(os.path.dirname(chosen_jvm), \"../../..\"))\n","    os.environ[\"JAVA_HOME\"] = java_root\n","\n","from pyserini.search.lucene import LuceneSearcher\n","\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","\n","# 2. Paths Setup\n","BASE_DIR = '/content/drive/My Drive/Objective 1'\n","BM25_DIR = os.path.join(BASE_DIR, 'indices', 'bm25')\n","SUPERVISION_DIR = os.path.join(BASE_DIR, 'laro_supervision')\n","os.makedirs(SUPERVISION_DIR, exist_ok=True)\n","\n","ORACLE_DATASET_PATH = os.path.join(SUPERVISION_DIR, 'laro_oracle_supervision_2000.jsonl')\n","\n","# Load BM25 Searcher\n","bm25_searcher = LuceneSearcher(BM25_DIR)\n","print(f\"✅ Lucene BM25 Searcher loaded! Total indexed docs: {bm25_searcher.num_docs:,}\")\n","\n","# 3. Load Generator Backbone & Tokenizer\n","from transformers import AutoTokenizer, AutoModelForSeq2SeqLM\n","MODEL_BACKBONE = \"google/flan-t5-base\"\n","\n","if 'model' not in globals():\n","    print(f\"[INFO] Loading Generator Backbone ({MODEL_BACKBONE})...\")\n","    tokenizer = AutoTokenizer.from_pretrained(MODEL_BACKBONE)\n","    model = AutoModelForSeq2SeqLM.from_pretrained(\n","        MODEL_BACKBONE, output_attentions=True, output_hidden_states=True\n","    ).to(device)\n","    model.eval()\n","\n","# 4. Epistemic Signals Extractor\n","def extract_epistemic_signals(query_text):\n","    input_ids = tokenizer.encode(query_text, return_tensors=\"pt\").to(device)\n","    with torch.no_grad():\n","        outputs = model(input_ids=input_ids, decoder_input_ids=input_ids)\n","        logits = outputs.logits\n","        attentions = outputs.encoder_attentions\n","\n","    log_probs = F.log_softmax(logits, dim=-1)\n","    target_log_probs = log_probs[0, range(input_ids.shape[1]-1), input_ids[0, 1:]]\n","    neg_log_likelihood = -target_log_probs.mean()\n","    perplexity = torch.exp(neg_log_likelihood).item()\n","\n","    probs = F.softmax(logits, dim=-1)\n","    top2_probs, _ = torch.topk(probs, k=2, dim=-1)\n","    margin = (top2_probs[0, :, 0] - top2_probs[0, :, 1]).mean().item()\n","    log_prob_dispersion = torch.std(target_log_probs).item()\n","\n","    layer_entropies = []\n","    for layer_attn in attentions:\n","        p = layer_attn + 1e-9\n","        entropy = -torch.sum(p * torch.log(p), dim=-1).mean().item()\n","        layer_entropies.append(entropy)\n","\n","    mean_attention_entropy = float(np.mean(layer_entropies))\n","\n","    return {\n","        \"query\": query_text,\n","        \"sigma_ppl\": round(perplexity, 4),\n","        \"sigma_attn_entropy\": round(mean_attention_entropy, 4),\n","        \"log_prob_dispersion\": round(log_prob_dispersion, 4),\n","        \"top_margin\": round(margin, 4)\n","    }\n","\n","# 5. Collect 2,000 Stratified Queries from KILT Task Splits\n","print(\"\\n======================================================================\")\n","print(\" 1. COLLECTING 2,000 STRATIFIED SUPERVISION QUERIES\")\n","print(\"======================================================================\")\n","\n","tasks_config = [\n","    (\"nq\", 800),                          # 800 Factoid Queries\n","    (\"hotpotqa\", 700),                    # 700 Multi-hop Reasoning Queries\n","    (\"triviaqa_support_only\", 500)        # 500 Open-domain Queries\n","]\n","\n","queries_pool = []\n","\n","for task_name, count in tasks_config:\n","    print(f\"➜ Fetching {count} samples from {task_name.upper()}...\")\n","    ds = load_dataset(\"facebook/kilt_tasks\", task_name, split=\"validation\")\n","\n","    extracted = 0\n","    for item in ds:\n","        q_text = item.get(\"input\", \"\")\n","        answers = [alt.get(\"answer\", \"\") for alt in item.get(\"output\", []) if alt.get(\"answer\")]\n","\n","        if q_text and answers:\n","            queries_pool.append({\n","                \"task\": task_name,\n","                \"query\": q_text,\n","                \"answers\": answers\n","            })\n","            extracted += 1\n","            if extracted >= count:\n","                break\n","\n","print(f\"✅ Total Supervision Query Pool: {len(queries_pool):,} samples\")\n","\n","# 6. Cost-Weighted Reward Function Parameters (Section 3.2.1.2)\n","LAMBDA_LATENCY = 0.05  # Latency penalty hyperparameter\n","\n","def check_exact_match(prediction_text, ground_truths):\n","    pred_clean = prediction_text.lower().strip()\n","    for gt in ground_truths:\n","        if gt.lower().strip() in pred_clean or pred_clean in gt.lower().strip():\n","            return 1.0\n","    return 0.0\n","\n","# 7. Trajectory Simulation Loop\n","print(\"\\n======================================================================\")\n","print(\" 2. EXECUTING TRAJECTORY SIMULATION & ORACLE LABELING\")\n","print(\"======================================================================\")\n","\n","oracle_records = []\n","\n","for item in tqdm(queries_pool, desc=\"Simulating Trajectories\"):\n","    q_text = item[\"query\"]\n","    gts = item[\"answers\"]\n","\n","    # A. Extract Epistemic Uncertainty Signals\n","    signals = extract_epistemic_signals(q_text)\n","\n","    # B. Simulate Action 0: SKIP (Parametric Memory)\n","    t0 = time.time()\n","    input_ids = tokenizer.encode(q_text, return_tensors=\"pt\").to(device)\n","    with torch.no_grad():\n","        gen_out = model.generate(input_ids, max_new_tokens=30)\n","        ans_skip = tokenizer.decode(gen_out[0], skip_special_tokens=True)\n","    lat_skip = time.time() - t0\n","    acc_skip = check_exact_match(ans_skip, gts)\n","    reward_skip = acc_skip - (LAMBDA_LATENCY * lat_skip)\n","\n","    # C. Simulate Action 1: SPARSE-TOP5 (BM25 Search) - Fixed Pyserini API\n","    t0 = time.time()\n","    hits = bm25_searcher.search(q_text, k=5)\n","\n","    retrieved_texts = []\n","    for h in hits:\n","        doc_obj = bm25_searcher.doc(h.docid)\n","        if doc_obj and doc_obj.raw():\n","            try:\n","                raw_data = json.loads(doc_obj.raw())\n","                retrieved_texts.append(raw_data.get(\"contents\", \"\"))\n","            except:\n","                retrieved_texts.append(doc_obj.contents())\n","\n","    augmented_prompt = f\"Context: {' '.join(retrieved_texts)[:1000]} Query: {q_text}\"\n","\n","    input_ids_aug = tokenizer.encode(augmented_prompt, return_tensors=\"pt\", truncation=True, max_length=512).to(device)\n","    with torch.no_grad():\n","        gen_out_sparse = model.generate(input_ids_aug, max_new_tokens=30)\n","        ans_sparse = tokenizer.decode(gen_out_sparse[0], skip_special_tokens=True)\n","    lat_sparse = time.time() - t0\n","    acc_sparse = check_exact_match(ans_sparse, gts)\n","    reward_sparse = acc_sparse - (LAMBDA_LATENCY * lat_sparse)\n","\n","    # D. Determine Oracle Action a* (Maximizing Cost-Weighted Reward)\n","    rewards = {\n","        \"SKIP\": reward_skip,\n","        \"SPARSE_TOP5\": reward_sparse\n","    }\n","\n","    optimal_action = max(rewards, key=rewards.get)\n","\n","    oracle_records.append({\n","        \"query\": q_text,\n","        \"task\": item[\"task\"],\n","        \"sigma_ppl\": signals[\"sigma_ppl\"],\n","        \"sigma_attn_entropy\": signals[\"sigma_attn_entropy\"],\n","        \"log_prob_dispersion\": signals[\"log_prob_dispersion\"],\n","        \"top_margin\": signals[\"top_margin\"],\n","        \"oracle_action\": optimal_action,\n","        \"reward_skip\": round(reward_skip, 4),\n","        \"reward_sparse\": round(reward_sparse, 4)\n","    })\n","\n","# 8. Save Oracle Supervision Dataset to Google Drive\n","with open(ORACLE_DATASET_PATH, 'w', encoding='utf-8') as f:\n","    for rec in oracle_records:\n","        f.write(json.dumps(rec) + '\\n')\n","\n","print(\"\\n======================================================================\")\n","print(\" ORACLE SUPERVISION DATASET CREATION COMPLETE\")\n","print(\"======================================================================\")\n","print(f\"✅ Supervision Dataset Saved At: {ORACLE_DATASET_PATH}\")\n","print(f\"✅ Total Annotated Samples    : {len(oracle_records):,}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-NDyZKhFHxj-","executionInfo":{"status":"ok","timestamp":1785216676917,"user_tz":-480,"elapsed":1276810,"user":{"displayName":"MUHAMMAD ALI","userId":"01574840028316529342"}},"outputId":"a9fe4c1c-cfed-4467-e8b6-596a4158ca5f"},"id":"-NDyZKhFHxj-","execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Lucene BM25 Searcher loaded! Total indexed docs: 21,113,601\n","\n","======================================================================\n"," 1. COLLECTING 2,000 STRATIFIED SUPERVISION QUERIES\n","======================================================================\n","➜ Fetching 800 samples from NQ...\n","➜ Fetching 700 samples from HOTPOTQA...\n","➜ Fetching 500 samples from TRIVIAQA_SUPPORT_ONLY...\n","✅ Total Supervision Query Pool: 1,500 samples\n","\n","======================================================================\n"," 2. EXECUTING TRAJECTORY SIMULATION & ORACLE LABELING\n","======================================================================\n"]},{"output_type":"stream","name":"stderr","text":["Simulating Trajectories: 100%|██████████| 1500/1500 [21:07<00:00,  1.18it/s]\n"]},{"output_type":"stream","name":"stdout","text":["\n","================